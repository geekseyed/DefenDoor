@page "/reports"
@rendermode InteractiveServer
@using ISCM.Application.Interfaces
@using ISCM.Application.Snapshots
@using ISCM.Domain.Entities
@using ISCM.Domain.Enums
@using ISCM.Web.Services
@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms
@inject IReportService ReportService
@inject ISnapshotDiffEngine DiffEngine
@inject ISnapshotRepository SnapshotRepository
@inject ISnapshotExportService ExportService
@inject ScanStateService StateService
@inject ScanHistoryService HistoryService
@inject ReportGateService GateService
@inject ISCM.Application.Interfaces.IReportTemplateService TemplateService

<PageTitle>DefenDoor - Reports</PageTitle>

<style>
    .glass-panel {
        background: rgba(30,41,59,0.7);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 8px 32px 0 rgba(0,0,0,0.37);
        box-sizing: border-box;
    }

    .header-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
    }

    .btn-back {
        background: #334155;
        border: none;
        padding: 8px 20px;
        color: #06b6d4;
        font-weight: bold;
        border-radius: 6px;
        cursor: pointer;
        text-decoration: none;
        font-size: 12px;
    }

    .subtab-bar {
        display: flex;
        gap: 8px;
        border-bottom: 1px solid #1e293b;
        margin-bottom: 16px;
        flex-wrap: wrap;
    }

    .subtab {
        background: transparent;
        border: 1px solid transparent;
        border-bottom: 2px solid transparent;
        color: #94a3b8;
        font-size: 12px;
        font-weight: bold;
        padding: 8px 16px;
        border-radius: 8px 8px 0 0;
        cursor: pointer;
        transition: 0.2s;
        display: flex;
        gap: 6px;
        align-items: center;
    }

        .subtab:hover {
            color: #e2e8f0;
            background: rgba(6,182,212,0.05);
        }

        .subtab.active {
            color: #06b6d4;
            border-color: rgba(6,182,212,0.4);
            border-bottom-color: #06b6d4;
            background: rgba(6,182,212,0.08);
            box-shadow: 0 0 12px rgba(6,182,212,0.15);
        }

    .subtab-icon {
        font-size: 14px;
    }

    .section-title {
        color: #94a3b8;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin: 0 0 10px 0;
    }

    .section-sub {
        color: #64748b;
        font-size: 11px;
        margin: -6px 0 10px 0;
    }

    .panel {
        background: rgba(15,23,42,0.6);
        border: 1px solid #1e293b;
        border-radius: 10px;
        padding: 16px;
        margin-bottom: 16px;
    }

    .type-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
    }

    .type-card {
        background: rgba(15,23,42,0.8);
        border: 1px solid #334155;
        border-radius: 8px;
        padding: 12px;
        cursor: pointer;
        text-align: center;
        transition: 0.2s;
        position: relative;
    }

        .type-card:hover {
            border-color: #06b6d4;
        }

        .type-card.active {
            border-color: #06b6d4;
            background: rgba(6,182,212,0.08);
        }

        .type-card.disabled {
            opacity: 0.45;
            cursor: not-allowed;
        }

    .type-icon {
        font-size: 22px;
    }

    .type-name {
        color: #e2e8f0;
        font-weight: bold;
        font-size: 12px;
        margin-top: 6px;
    }

    .type-desc {
        color: #64748b;
        font-size: 10px;
        margin-top: 4px;
    }

    .gate-badge {
        position: absolute;
        top: 6px;
        right: 6px;
        font-size: 8px;
        font-weight: bold;
        font-family: 'Consolas', monospace;
        padding: 2px 6px;
        border-radius: 3px;
        letter-spacing: 1px;
    }

        .gate-badge.locked {
            background: rgba(148,163,184,0.15);
            color: #94a3b8;
        }

        .gate-badge.firstallowed {
            background: rgba(16,185,129,0.15);
            color: #10b981;
        }

        .gate-badge.blocked {
            background: rgba(245,158,11,0.15);
            color: #f59e0b;
        }

        .gate-badge.changeallowed {
            background: rgba(6,182,212,0.15);
            color: #06b6d4;
        }

    .ctx-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px 24px;
    }

    .ctx-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid rgba(51,65,85,0.5);
        padding: 8px 0;
    }

    .ctx-label {
        color: #64748b;
        font-size: 11px;
        text-transform: uppercase;
    }

    .ctx-value {
        color: #e2e8f0;
        font-family: 'Consolas', monospace;
        font-weight: bold;
        font-size: 12px;
    }

    .chip-row {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
    }

    .chip {
        background: transparent;
        border: 1px solid #334155;
        color: #94a3b8;
        font-size: 10px;
        padding: 4px 10px;
        border-radius: 4px;
        cursor: pointer;
    }

        .chip.active {
            background: #06b6d4;
            border-color: #06b6d4;
            color: white;
        }

    .btn-edit {
        background: #334155;
        border: none;
        color: #e2e8f0;
        font-size: 11px;
        font-weight: bold;
        padding: 4px 14px;
        border-radius: 4px;
        cursor: pointer;
    }

    .sys-input {
        background: #0f172a;
        border: 1px solid #334155;
        color: #e2e8f0;
        font-family: 'Consolas', monospace;
        font-size: 12px;
        padding: 4px 8px;
        border-radius: 4px;
        width: 60%;
    }

    .btn-save {
        background: #10b981;
        border: none;
        color: white;
        font-weight: bold;
        font-size: 11px;
        padding: 6px 16px;
        border-radius: 6px;
        cursor: pointer;
    }

    .btn-cancel {
        background: #475569;
        border: none;
        color: white;
        font-weight: bold;
        font-size: 11px;
        padding: 6px 16px;
        border-radius: 6px;
        cursor: pointer;
    }

    .sections-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px 24px;
    }

    .section-check {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 6px 0;
        border-bottom: 1px solid rgba(51,65,85,0.4);
    }

        .section-check input {
            accent-color: #06b6d4;
            width: 14px;
            height: 14px;
        }

    .sc-title {
        color: #e2e8f0;
        font-size: 12px;
        font-weight: bold;
    }

    .sc-desc {
        color: #64748b;
        font-size: 10px;
    }

    .link-btn {
        background: none;
        border: none;
        color: #06b6d4;
        font-size: 11px;
        cursor: pointer;
        font-weight: bold;
    }

    .sign-row {
        display: flex;
        gap: 24px;
        margin-top: 12px;
    }

    .sign-item {
        font-size: 11px;
        color: #94a3b8;
    }

    .sign-ok {
        color: #10b981;
        font-weight: bold;
    }

    .sign-pending {
        color: #f59e0b;
        font-weight: bold;
    }

    .fmt-grid {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 10px;
    }

    .fmt-card {
        background: rgba(15,23,42,0.8);
        border: 1px solid #334155;
        border-radius: 8px;
        padding: 10px;
        cursor: pointer;
        text-align: center;
        transition: 0.2s;
    }

        .fmt-card:hover {
            border-color: #06b6d4;
        }

        .fmt-card.active {
            border-color: #06b6d4;
            background: rgba(6,182,212,0.08);
        }

    .fmt-name {
        color: #e2e8f0;
        font-weight: bold;
        font-size: 11px;
        margin-top: 4px;
    }

    .fmt-desc {
        color: #64748b;
        font-size: 9px;
        margin-top: 2px;
    }

    .opts-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 6px 24px;
    }

    .outline-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin: 12px 0;
    }

    .outline-pages {
        color: #94a3b8;
        font-size: 12px;
    }

    .action-row {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .btn-generate {
        background: linear-gradient(45deg, #06b6d4, #3b82f6);
        border: none;
        color: white;
        font-weight: bold;
        padding: 10px 24px;
        border-radius: 8px;
        cursor: pointer;
    }

        .btn-generate:disabled {
            background: #475569;
            cursor: not-allowed;
        }

    .btn-secondary {
        background: #1e293b;
        border: 1px solid #334155;
        color: #e2e8f0;
        font-size: 12px;
        padding: 10px 18px;
        border-radius: 8px;
        cursor: pointer;
    }

    .result-message {
        margin-top: 14px;
        padding: 12px;
        border-radius: 8px;
        font-size: 13px;
        word-break: break-all;
    }

    .empty-state {
        color: #64748b;
        text-align: center;
        padding: 40px;
        font-size: 13px;
    }

    .compare-selector {
        display: grid;
        grid-template-columns: 1fr auto 1fr auto;
        gap: 12px;
        align-items: end;
        margin-bottom: 16px;
    }

    .selector-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .selector-label {
        color: #94a3b8;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .selector-dropdown {
        background: #0f172a;
        border: 1px solid #334155;
        color: #e2e8f0;
        font-family: 'Consolas', monospace;
        font-size: 12px;
        padding: 8px 12px;
        border-radius: 6px;
        width: 100%;
    }

    .btn-compare {
        background: linear-gradient(45deg, #8b5cf6, #06b6d4);
        border: none;
        color: white;
        font-weight: bold;
        padding: 10px 24px;
        border-radius: 8px;
        cursor: pointer;
        white-space: nowrap;
    }

        .btn-compare:disabled {
            background: #475569;
            cursor: not-allowed;
        }

    .diff-summary {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 10px;
        margin-bottom: 16px;
    }

    .diff-stat {
        background: rgba(15,23,42,0.8);
        border: 1px solid #334155;
        border-radius: 8px;
        padding: 12px;
        text-align: center;
    }

    .diff-stat-value {
        font-size: 24px;
        font-weight: 800;
        font-family: 'Consolas', monospace;
        line-height: 1;
    }

    .diff-stat-label {
        color: #94a3b8;
        font-size: 10px;
        text-transform: uppercase;
        margin-top: 6px;
    }

    .diff-stat.improved .diff-stat-value { color: #10b981; }
    .diff-stat.regressed .diff-stat-value { color: #ef4444; }
    .diff-stat.added .diff-stat-value { color: #06b6d4; }
    .diff-stat.removed .diff-stat-value { color: #f59e0b; }
    .diff-stat.changed .diff-stat-value { color: #8b5cf6; }
    .diff-stat.unchanged .diff-stat-value { color: #64748b; }

    .verdict-banner {
        padding: 12px 16px;
        border-radius: 8px;
        margin-bottom: 16px;
        font-weight: bold;
        font-size: 14px;
        text-align: center;
    }

    .verdict-identical { background: rgba(100,116,139,0.2); color: #94a3b8; }
    .verdict-improved { background: rgba(16,185,129,0.2); color: #10b981; }
    .verdict-regressed { background: rgba(239,68,68,0.2); color: #ef4444; }
    .verdict-mixed { background: rgba(245,158,11,0.2); color: #f59e0b; }
    .verdict-drifted { background: rgba(139,92,246,0.2); color: #8b5cf6; }
    .verdict-baseline { background: rgba(6,182,212,0.2); color: #06b6d4; }

    .diff-tree {
        max-height: 500px;
        overflow-y: auto;
    }

    .diff-node {
        margin-bottom: 8px;
    }

    .diff-branch {
        background: rgba(15,23,42,0.8);
        border: 1px solid #334155;
        border-radius: 6px;
        padding: 10px 12px;
        cursor: pointer;
        transition: 0.2s;
    }

        .diff-branch:hover {
            border-color: #06b6d4;
        }

    .diff-branch-header {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .diff-icon {
        font-size: 14px;
        width: 20px;
    }

    .diff-subcontrol-id {
        color: #06b6d4;
        font-family: 'Consolas', monospace;
        font-size: 11px;
        font-weight: bold;
    }

    .diff-change-type {
        font-size: 10px;
        padding: 2px 8px;
        border-radius: 4px;
        font-weight: bold;
    }

    .change-improved { background: rgba(16,185,129,0.2); color: #10b981; }
    .change-regressed { background: rgba(239,68,68,0.2); color: #ef4444; }
    .change-added { background: rgba(6,182,212,0.2); color: #06b6d4; }
    .change-removed { background: rgba(245,158,11,0.2); color: #f59e0b; }
    .change-changed { background: rgba(139,92,246,0.2); color: #8b5cf6; }

    .diff-values {
        display: flex;
        gap: 16px;
        margin-top: 6px;
        font-size: 11px;
    }

    .diff-old { color: #ef4444; }
    .diff-new { color: #10b981; }
    .diff-arrow { color: #64748b; }

    .diff-reason {
        color: #94a3b8;
        font-size: 10px;
        margin-top: 4px;
        font-style: italic;
    }

    .export-import-bar {
        display: flex;
        gap: 10px;
        align-items: center;
        margin-bottom: 16px;
        flex-wrap: wrap;
    }

    .btn-export {
        background: linear-gradient(45deg, #06b6d4, #3b82f6);
        border: none;
        color: white;
        font-weight: bold;
        padding: 8px 16px;
        border-radius: 6px;
        cursor: pointer;
        font-size: 11px;
    }

    .btn-import {
        background: linear-gradient(45deg, #10b981, #059669);
        border: none;
        color: white;
        font-weight: bold;
        padding: 8px 16px;
        border-radius: 6px;
        cursor: pointer;
        font-size: 11px;
    }

    .btn-export-small {
        background: #1e293b;
        border: 1px solid #334155;
        color: #06b6d4;
        font-size: 10px;
        padding: 4px 10px;
        border-radius: 4px;
        cursor: pointer;
    }

        .btn-export-small:hover {
            border-color: #06b6d4;
            background: rgba(6, 182, 212, 0.1);
        }

    .btn-export-small:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .import-results {
        margin-top: 16px;
    }

    .import-result-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 12px;
        background: rgba(15, 23, 42, 0.8);
        border: 1px solid #334155;
        border-radius: 6px;
        margin-bottom: 6px;
        font-size: 11px;
    }

    .import-result-item.success { border-left: 3px solid #10b981; }
    .import-result-item.duplicate { border-left: 3px solid #f59e0b; }
    .import-result-item.error { border-left: 3px solid #ef4444; }

    .import-result-icon { font-size: 14px; }

    .import-result-file {
        color: #06b6d4;
        font-family: 'Consolas', monospace;
        flex: 1;
    }

    .import-result-message { color: #94a3b8; }

    .import-result-status {
        font-weight: bold;
        font-size: 10px;
        padding: 2px 8px;
        border-radius: 3px;
    }

    .status-success { background: rgba(16,185,129,0.2); color: #10b981; }
    .status-duplicate { background: rgba(245,158,11,0.2); color: #f59e0b; }
    .status-invalid, .status-failed, .status-integrityfailed { background: rgba(239,68,68,0.2); color: #ef4444; }

    .file-input-hidden { display: none; }

    .compliance-table-wrap {
        margin-top: 12px;
        overflow-x: auto;
    }

    .compliance-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 11px;
    }

        .compliance-table th {
            background: #0f172a;
            color: #94a3b8;
            text-transform: uppercase;
            font-size: 10px;
            letter-spacing: 1px;
            padding: 8px 10px;
            text-align: left;
            border-bottom: 1px solid #334155;
        }

        .compliance-table td {
            padding: 8px 10px;
            border-bottom: 1px solid rgba(51,65,85,0.4);
            color: #e2e8f0;
        }

        .compliance-table code {
            color: #06b6d4;
            font-family: 'Consolas', monospace;
            font-size: 10px;
        }

    /* ═══════════════════════════════════════════════════════════
       Phase 16.3: Custom Templates Styles
       ═══════════════════════════════════════════════════════════ */
    .template-info-box {
        background: rgba(15,23,42,0.6);
        padding: 10px;
        border-radius: 6px;
        margin-bottom: 12px;
        font-size: 11px;
        border-left: 3px solid #06b6d4;
    }

    .template-info-box .template-name {
        color: #06b6d4;
        font-weight: bold;
        margin-bottom: 4px;
    }

    .template-info-box .template-desc {
        color: #94a3b8;
    }
</style>

<div class="glass-panel">
    <div class="header-row">
        <h2 style="color:#e2e8f0; margin:0;">Reports & Export Center</h2>
        <a href="/" class="btn-back">← Back to Dashboard</a>
    </div>

    <div class="subtab-bar">
        @foreach (var t in SubTabs)
        {
            <button class="subtab @(ActiveSubTab == t.Id ? "active" : "")" @onclick="() => ActiveSubTab = t.Id">
                <span class="subtab-icon">@t.Icon</span> @t.Name
            </button>
        }
    </div>

    @if (StateService.CurrentScanResult == null && ActiveSubTab != "baseline" && ActiveSubTab != "ledger")
    {
        <p class="empty-state">No scan data available for reporting. Please run a scan from the Dashboard first.</p>
    }
    else if (ActiveSubTab == "generator")
    {
        <div class="panel">
            <div class="section-title">Report Type</div>
            <div class="section-sub">نوع گزارش را انتخاب کنید</div>
            <div class="type-grid">
                <div class="type-card @(SelectedReportType == "current" ? "active" : "") @(CurrentGate.Kind == GateKind.Locked ? "disabled" : "")"
                     @onclick="SelectCurrentType">
                    <span class="gate-badge @CurrentGate.Kind.ToString().ToLower()">
                        @(CurrentGate.Kind switch { GateKind.Locked => "LOCKED", GateKind.FirstAllowed => "READY", GateKind.Blocked => "NO CHANGE", _ => "CHANGED" })
                    </span>
                    <div class="type-icon">📸</div>
                    <div class="type-name">Current State</div>
                    <div class="type-desc">وضعیت فعلی سیستم (Baseline)</div>
                </div>
                <div class="type-card @(SelectedReportType == "beforeafter" ? "active" : "")" @onclick="SelectBeforeAfterType">
                    <div class="type-icon">📋</div>
                    <div class="type-name">Before/After</div>
                    <div class="type-desc">مقایسه قبل و بعد هاردنینگ</div>
                </div>
                <div class="type-card @(SelectedReportType == "remediation" ? "active" : "")" @onclick="SelectRemediationType">
                    <div class="type-icon">✅</div>
                    <div class="type-name">Remediation</div>
                    <div class="type-desc">گزارش اصلاح و بسترسازی</div>
                </div>
            </div>
        </div>

        @* ═══════════════════════════════════════════════════════════
           Phase 16.3: Custom Templates Panel
           ═══════════════════════════════════════════════════════════ *@
        <div class="panel">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 12px;">
                <div>
                    <div class="section-title" style="margin-bottom:2px;">📋 Custom Templates</div>
                    <div class="section-sub">قالب‌های ذخیره‌شده را انتخاب یا تنظیمات فعلی را ذخیره کنید</div>
                </div>
                @if (_isLoadingTemplates)
                {
                    <span style="color:#64748b; font-size:11px;">Loading templates...</span>
                }
            </div>
            
            @if (_templates.Count > 0)
            {
                <div style="margin-bottom: 12px;">
                    <label style="color:#94a3b8; font-size:11px; display:block; margin-bottom:6px;">Select Template:</label>
                    <select class="selector-dropdown" @onchange="e => { 
                        var id = e.Value?.ToString();
                        _selectedTemplate = _templates.FirstOrDefault(t => t.TemplateId == id);
                        if (_selectedTemplate != null) ApplyTemplate(_selectedTemplate);
                    }">
                        @foreach (var t in _templates)
                        {
                            <option value="@t.TemplateId" selected="@(t.TemplateId == _selectedTemplate?.TemplateId)">
                                @t.Name @(t.TemplateId.StartsWith("builtin-") ? "(Built-in)" : "")
                            </option>
                        }
                    </select>
                </div>
                
                @if (_selectedTemplate != null)
                {
                    <div class="template-info-box">
                        <div class="template-name">@_selectedTemplate.Name</div>
                        <div class="template-desc">@_selectedTemplate.Description</div>
                        <div style="margin-top:6px; display:flex; gap:12px; flex-wrap:wrap;">
                            <span style="color:#64748b;">Format: <span style="color:#e2e8f0;">@_selectedTemplate.PreferredFormat</span></span>
                            @if (_selectedTemplate.IncludeRawEvidence)
                            {
                                <span style="color:#10b981;">✓ Raw Evidence</span>
                            }
                            @if (_selectedTemplate.IsBilingual)
                            {
                                <span style="color:#06b6d4;">✓ Bilingual</span>
                            }
                        </div>
                        @if (!_selectedTemplate.TemplateId.StartsWith("builtin-"))
                        {
                            <button class="btn-cancel" style="margin-top:8px; padding:4px 12px; font-size:10px;" 
                                    @onclick="() => DeleteTemplateAsync(_selectedTemplate.TemplateId)">
                                🗑️ Delete Template
                            </button>
                        }
                    </div>
                }
            }
            
            <div style="border-top:1px solid #334155; padding-top:12px; margin-top:12px;">
                <div style="color:#94a3b8; font-size:11px; margin-bottom:8px;">Save Current Settings as New Template:</div>
                <div style="display:flex; gap:8px; margin-bottom:8px;">
                    <input type="text" class="sys-input" style="flex:1; width:auto;" 
                           placeholder="Template Name (e.g., 'Monthly Compliance Report')" 
                           @bind="_newTemplateName" />
                </div>
                <div style="display:flex; gap:8px;">
                    <input type="text" class="sys-input" style="flex:1; width:auto;" 
                           placeholder="Description (optional)" 
                           @bind="_newTemplateDescription" />
                    <button class="btn-save" @onclick="SaveCurrentAsTemplateAsync">💾 Save Template</button>
                </div>
            </div>
        </div>

        <div class="panel">
            <div style="display:flex; justify-content:space-between; align-items:center;">
                <div>
                    <div class="section-title" style="margin-bottom:2px;">Report Sections</div>
                    <div class="section-sub">بخش‌های گزارش را انتخاب کنید</div>
                </div>
                <span>
                    <button class="link-btn" @onclick="SelectAllSections">Select All</button>
                    <button class="link-btn" @onclick="DeselectAllSections">Deselect All</button>
                </span>
            </div>
            <div class="sections-grid">
                @foreach (var s in Sections)
                {
                    <label class="section-check">
                        <input type="checkbox" @bind="s.Enabled" />
                        <span><span class="sc-title">@s.TitleEn</span> <span class="sc-desc">— @s.DescFa</span></span>
                    </label>
                }
            </div>
            <div class="sign-row">
                <span class="sign-item">Prepared By <span class="sign-ok">✓ Signed</span></span>
                <span class="sign-item">Reviewed By <span class="sign-ok">✓ Signed</span></span>
                <span class="sign-item">Approved By <span class="sign-pending">⏳ Pending</span></span>
            </div>
        </div>

        <div class="panel">
            <div class="section-title">Export Format & Path</div>
            <div class="fmt-grid">
                @foreach (var f in ExportFormats)
                {
                    <div class="fmt-card @(SelectedFormat == f.Id ? "active" : "")" @onclick="() => SelectedFormat = f.Id">
                        <div class="type-icon">@f.Icon</div>
                        <div class="fmt-name">@f.Name</div>
                        <div class="fmt-desc">@f.Desc</div>
                    </div>
                }
            </div>
        </div>

        <div class="panel">
            <div class="section-title">Export Options</div>
            <div class="opts-grid">
                <label class="section-check"><input type="checkbox" @bind="OptBeforeAfter" /><span><span class="sc-title">Include Before/After Comparison</span> <span class="sc-desc">— شامل مقایسه قبل و بعد</span></span></label>
                <label class="section-check"><input type="checkbox" @bind="OptRawEvidence" /><span><span class="sc-title">Include Raw Evidence Files</span> <span class="sc-desc">— شامل فایل‌های خام شواهد</span></span></label>
                <label class="section-check"><input type="checkbox" @bind="OptHashes" /><span><span class="sc-title">Include File Hashes (SHA-256)</span> <span class="sc-desc">— هش فایل‌ها برای یکپارچگی</span></span></label>
                <label class="section-check"><input type="checkbox" @bind="OptBilingual" /><span><span class="sc-title">Bilingual (EN + FA)</span> <span class="sc-desc">— گزارش دو زبانه</span></span></label>
                <label class="section-check"><input type="checkbox" @bind="OptScreenshots" /><span><span class="sc-title">Include Screenshots</span> <span class="sc-desc">— اسکرین‌شات از سیستم</span></span></label>
                <label class="section-check"><input type="checkbox" @bind="OptEncrypt" /><span><span class="sc-title">Encrypt Report (Password)</span> <span class="sc-desc">— رمزنگاری خروجی</span></span></label>
            </div>
        </div>

        <div class="panel">
            <div class="outline-row"><span class="outline-pages">Report Outline ~@(EstimatedPages) pages</span></div>
            <div class="action-row">
                <button class="btn-generate" @onclick="GenerateReportAsync" disabled="@_isExporting">@(_isExporting ? "Generating..." : "Generate Report")</button>
                <button class="btn-secondary" @onclick="PreviewReport">Preview</button>
                <button class="btn-secondary" @onclick="EmailReport">Email Report</button>
                <button class="btn-secondary" @onclick="ScheduleReport">Schedule Recurring</button>
            </div>
            @if (_errorMessage != null)
            {
                <div class="result-message" style="background: rgba(239,68,68,0.1); color: #ef4444;">⚠️ @_errorMessage</div>
            }
            @if (_savedFilePath != null)
            {
                <div class="result-message" style="background: rgba(16,185,129,0.1); color: #10b981;">✅ Report saved at: <code style="color:#06b6d4;">@_savedFilePath</code></div>
            }
        </div>
    }
    else if (ActiveSubTab == "beforeafter")
    {
        <div class="panel">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 16px;">
                <div>
                    <div class="section-title" style="margin-bottom:2px;">Snapshot Comparison</div>
                    <div class="section-sub">مقایسه دو Snapshot تاریخی با استفاده از SnapshotDiffEngine</div>
                </div>
                <button class="btn-edit" @onclick="RefreshSnapshots">🔄 Refresh History</button>
            </div>

            <div class="compare-selector">
                <div class="selector-group">
                    <label class="selector-label">Source Snapshot (Before)</label>
                    <select class="selector-dropdown" @bind="SelectedSourceId">
                        <option value="">-- Select Source --</option>
                        @foreach (var entry in SnapshotHistory)
                        {
                            <option value="@entry.SnapshotId">@entry.Hostname | @(entry.ScanTime.ToString("yyyy-MM-dd HH:mm")) | @entry.Grade (@entry.ComplianceScore%)</option>
                        }
                    </select>
                </div>

                <div style="font-size: 24px; color: #06b6d4;">→</div>

                <div class="selector-group">
                    <label class="selector-label">Target Snapshot (After)</label>
                    <select class="selector-dropdown" @bind="SelectedTargetId">
                        <option value="">-- Select Target --</option>
                        @foreach (var entry in SnapshotHistory)
                        {
                            <option value="@entry.SnapshotId">@entry.Hostname | @(entry.ScanTime.ToString("yyyy-MM-dd HH:mm")) | @entry.Grade (@entry.ComplianceScore%)</option>
                        }
                    </select>
                </div>

                <button class="btn-compare" @onclick="CompareSnapshots" disabled="@(!CanCompare || _isComparing)">
                    @(_isComparing ? "Comparing..." : "Compare")
                </button>
            </div>

            @if (_diffResult != null)
            {
                <div class="verdict-banner verdict-@_diffResult.OverallVerdict.ToString().ToLower()">
                    Overall Verdict: @_diffResult.OverallVerdict | Score Delta: @(_diffResult.ComplianceScoreDelta > 0 ? "+" : "")@_diffResult.ComplianceScoreDelta%
                </div>

                <div class="diff-summary">
                    <div class="diff-stat improved">
                        <div class="diff-stat-value">@_diffResult.Summary.Improved</div>
                        <div class="diff-stat-label">Improved</div>
                    </div>
                    <div class="diff-stat regressed">
                        <div class="diff-stat-value">@_diffResult.Summary.Regressed</div>
                        <div class="diff-stat-label">Regressed</div>
                    </div>
                    <div class="diff-stat added">
                        <div class="diff-stat-value">@_diffResult.Summary.Added</div>
                        <div class="diff-stat-label">Added</div>
                    </div>
                    <div class="diff-stat removed">
                        <div class="diff-stat-value">@_diffResult.Summary.Removed</div>
                        <div class="diff-stat-label">Removed</div>
                    </div>
                    <div class="diff-stat changed">
                        <div class="diff-stat-value">@_diffResult.Summary.Changed</div>
                        <div class="diff-stat-label">Changed</div>
                    </div>
                    <div class="diff-stat unchanged">
                        <div class="diff-stat-value">@_diffResult.Summary.Unchanged</div>
                        <div class="diff-stat-label">Unchanged</div>
                    </div>
                </div>

                <div class="section-title">SubControl Changes</div>
                <div class="diff-tree">
                    @if (_diffResult.SubControlChanges.Count == 0)
                    {
                        <p class="empty-state">No changes detected between the two snapshots.</p>
                    }
                    else
                    {
                        @foreach (var change in _diffResult.SubControlChanges.OrderBy(c => c.ChangeType))
                        {
                            <div class="diff-node">
                                <div class="diff-branch">
                                    <div class="diff-branch-header">
                                        <span class="diff-icon">@(change.ChangeType switch {
                                            ChangeType.Improved => "🟢",
                                            ChangeType.Regressed => "🔴",
                                            ChangeType.Added => "🔵",
                                            ChangeType.Removed => "🟠",
                                            ChangeType.Changed => "🟣",
                                            _ => "⚪"
                                        })</span>
                                        <span class="diff-subcontrol-id">@change.SubControlId</span>
                                        <span class="diff-change-type change-@change.ChangeType.ToString().ToLower()">@change.ChangeType</span>
                                    </div>
                                    <div class="diff-values">
                                        @if (change.OldStatus.HasValue && change.NewStatus.HasValue)
                                        {
                                            <span class="diff-old">Old: @change.OldStatus</span>
                                            <span class="diff-arrow">→</span>
                                            <span class="diff-new">New: @change.NewStatus</span>
                                        }
                                        else if (change.ChangeType == ChangeType.Added)
                                        {
                                            <span class="diff-new">New: @change.NewStatus</span>
                                        }
                                        else if (change.ChangeType == ChangeType.Removed)
                                        {
                                            <span class="diff-old">Old: @change.OldStatus</span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrEmpty(change.NewReason))
                                    {
                                        <div class="diff-reason">Reason: @change.NewReason</div>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            }
            else if (_compareError != null)
            {
                <div class="result-message" style="background: rgba(239,68,68,0.1); color: #ef4444;">⚠️ @_compareError</div>
            }
            else
            {
                <p class="empty-state">Select two snapshots and click Compare to see the differences.</p>
            }
        </div>
    }
    else if (ActiveSubTab == "system")
    {
        <div class="panel">
            <div style="display:flex; justify-content:space-between; align-items:center;">
                <div>
                    <div class="section-title" style="margin-bottom:2px;">Target System & Context</div>
                    <div class="section-sub">System details and operational context</div>
                </div>
                @if (!StateService.IsEditingSystemInfo)
                {
                    <button class="btn-edit" @onclick="StateService.StartEditingSystemInfo">Edit System Details</button>
                }
            </div>
            <div class="ctx-grid">
                <div class="ctx-row"><span class="ctx-label">Scan Date Gregorian</span><span class="ctx-value">@DateTime.Now.ToString("yyyy-MM-dd")</span></div>
                <div class="ctx-row"><span class="ctx-label">Persian (شمسی)</span><span class="ctx-value">@PersianDate</span></div>
                @if (StateService.IsEditingSystemInfo)
                {
                    <div class="ctx-row"><span class="ctx-label">Hostname</span><input class="sys-input" @bind="StateService.DraftHostname" /></div>
                    <div class="ctx-row"><span class="ctx-label">IP Address</span><input class="sys-input" @bind="StateService.DraftIpAddress" /></div>
                    <div class="ctx-row"><span class="ctx-label">OS Build</span><input class="sys-input" @bind="StateService.DraftOsBuild" /></div>
                    <div class="ctx-row"><span></span><span><button class="btn-save" @onclick="StateService.SaveSystemInfoEdits">Save</button> <button class="btn-cancel" @onclick="StateService.CancelSystemInfoEdits">Cancel</button></span></div>
                }
                else
                {
                    <div class="ctx-row"><span class="ctx-label">Hostname</span><span class="ctx-value">@StateService.DisplayHostname</span></div>
                    <div class="ctx-row"><span class="ctx-label">IP Address</span><span class="ctx-value">@StateService.DisplayIpAddress</span></div>
                    <div class="ctx-row"><span class="ctx-label">OS Build</span><span class="ctx-value">@StateService.DisplayOsBuild</span></div>
                }
                <div class="ctx-row">
                    <span class="ctx-label">Operational Context Zone</span>
                    <span class="chip-row">@foreach (var z in Zones)
                        {
                            <button class="chip @(StateService.SelectedZone == z ? "active" : "")" @onclick="() => StateService.SelectedZone = z">@z</button>
                        }</span>
                </div>
                <div class="ctx-row">
                    <span class="ctx-label">System Role</span>
                    <span class="chip-row">@foreach (var r in Roles)
                        {
                            <button class="chip @(StateService.SelectedSystem == r ? "active" : "")" @onclick="() => StateService.SelectedSystem = r">@r</button>
                        }</span>
                </div>
                <div class="ctx-row"><span class="ctx-label">Context Hostname</span><span class="ctx-value" style="color:#06b6d4;">@StateService.HostnameContext</span></div>
            </div>
        </div>
    }
    else if (ActiveSubTab == "baseline")
    {
        <div class="panel">
            <div class="section-title">Baseline Configuration</div>
            <div class="section-sub">ویرایش مقادیر Expected و فعال/غیرفعال کردن چک‌ها — به نام Madanchi</div>
            <p class="empty-state">🚧 This tab will be implemented in Stage 3 (Madanchi baseline: ASR / AppLocker / Windows Security / Audit Logs).</p>
        </div>
    }
    else if (ActiveSubTab == "ledger")
    {
        <div class="panel">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 16px;">
                <div>
                    <div class="section-title" style="margin-bottom:2px;">Report Ledger & Snapshot Archive</div>
                    <div class="section-sub">بایگانی گزارش‌ها و مدیریت Snapshotها (Export/Import برای محیط‌های AirGapped)</div>
                </div>
            </div>

            <div class="export-import-bar">
                <button class="btn-import" @onclick="TriggerImportFileDialog" disabled="@_isImporting">
                    @(_isImporting ? "⏳ Importing..." : "📥 Import Snapshots")
                </button>
                <InputFile OnChange="OnFilesSelected" multiple class="file-input-hidden" @ref="_fileInput" />
                <span style="color: #64748b; font-size: 11px;">
                    Import .defendoor.json files from AirGapped environments
                </span>
            </div>

            @if (_importResults.Any())
            {
                <div class="import-results">
                    <div class="section-title" style="margin-bottom: 8px;">Import Results</div>
                    @foreach (var result in _importResults)
                    {
                        <div class="import-result-item @result.Status.ToString().ToLower()">
                            <span class="import-result-icon">@(result.Status switch {
                                SnapshotImportStatus.Success => "✅",
                                SnapshotImportStatus.Duplicate => "⚠️",
                                _ => "❌"
                            })</span>
                            <span class="import-result-file">@result.FileName</span>
                            <span class="import-result-message">@result.Message</span>
                            <span class="import-result-status status-@result.Status.ToString().ToLower()">@result.Status</span>
                        </div>
                    }
                    <button class="btn-secondary" style="margin-top: 10px; padding: 6px 12px; font-size: 11px;" @onclick="ClearImportResults">Clear Results</button>
                </div>
            }

            <div class="section-title" style="margin-top: 20px;">Generated Reports</div>
            @if (GateService.Ledger.Count == 0 && SnapshotHistory.Count == 0)
            {
                <p class="empty-state">No reports or snapshots generated yet.</p>
            }
            else
            {
                <div class="compliance-table-wrap">
                    <table class="compliance-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Type</th>
                                <th>Format</th>
                                <th>File Name</th>
                                <th>Generated At</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var e in GateService.Ledger)
                            {
                                <tr>
                                    <td><code>R-@(e.Seq.ToString("D3"))</code></td>
                                    <td>@e.ReportType</td>
                                    <td>@e.Format.ToUpper()</td>
                                    <td style="color: #06b6d4; font-family: monospace; font-size: 10px;">@e.FileName</td>
                                    <td style="color: #64748b; font-family: monospace; font-size: 10px;">@(e.GeneratedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm"))</td>
                                    <td>
                                        <button class="btn-export-small" disabled title="Export from file system">📄 View File</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="section-title" style="margin-top: 20px;">Snapshot Archive (Export for AirGapped)</div>
                <div class="compliance-table-wrap">
                    <table class="compliance-table">
                        <thead>
                            <tr>
                                <th>Snapshot ID</th>
                                <th>Hostname</th>
                                <th>Date</th>
                                <th>Grade</th>
                                <th>Score</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var snapshot in SnapshotHistory)
                            {
                                <tr>
                                    <td><code>@(snapshot.SnapshotId?.ToString("N").Substring(0, 8) ?? "N/A")</code></td>
                                    <td>@snapshot.Hostname</td>
                                    <td style="color: #64748b; font-family: monospace; font-size: 10px;">@(snapshot.ScanTime.ToString("yyyy-MM-dd HH:mm"))</td>
                                    <td>@snapshot.Grade</td>
                                    <td>@snapshot.ComplianceScore%</td>
                                    <td>
                                        <button class="btn-export-small"
                                                @onclick="() => ExportSnapshotAsync(snapshot.SnapshotId)"
                                                disabled="@(_exportingSnapshotId == snapshot.SnapshotId)">
                                            @(_exportingSnapshotId == snapshot.SnapshotId ? "⏳ Exporting..." : "📤 Export")
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (!string.IsNullOrEmpty(_exportMessage))
                {
                    <div class="result-message" style="background: rgba(16,185,129,0.1); color: #10b981; margin-top: 12px;">
                        ✅ @_exportMessage
                    </div>
                }
                @if (!string.IsNullOrEmpty(_exportError))
                {
                    <div class="result-message" style="background: rgba(239,68,68,0.1); color: #ef4444; margin-top: 12px;">
                        ❌ @_exportError
                    </div>
                }
            }
        </div>
    }
</div>

@code {
    private string ActiveSubTab = "generator";
    private string SelectedReportType = "current";
    private string SelectedFormat = "html";
    private bool _isExporting;
    private string? _savedFilePath;
    private string? _errorMessage;

    private bool OptBeforeAfter = true;
    private bool OptRawEvidence = true;
    private bool OptHashes = false;
    private bool OptBilingual = true;
    private bool OptScreenshots = false;
    private bool OptEncrypt = false;

    private static readonly string[] Zones = { "MRDC", "AOC", "ERDC", "SRDC", "NRDC" };
    private static readonly string[] Roles = { "Shift Supervisor", "Shift Expert" };

    private static readonly List<(string Id, string Icon, string Name)> SubTabs = new()
    {
        ("generator", "⚙", "Generator"),
        ("beforeafter", "📈", "Before/After"),
        ("system", "🖥", "System & Context"),
        ("baseline", "📚", "Baseline"),
        ("ledger", "🗂", "Ledger & Archive")
    };

    private static readonly List<(string Id, string Icon, string Name, string Desc)> ExportFormats = new()
    {
        ("html", "📄", "HTML", "Interactive"),
        ("pdf", "📕", "PDF", "Printable"),
        ("excel", "📊", "Excel", "Spreadsheet"),
        ("json", "🧩", "JSON", "Machine-readable"),
        ("zip", "📦", "ZIP", "Bundle All + evidence"),
        ("csv", "✍", "CSV", "Findings only")
    };

    private class ReportSection { public string TitleEn { get; set; } = ""; public string DescFa { get; set; } = ""; public bool Enabled { get; set; } = true; }

    private List<ReportSection> Sections { get; set; } = new()
    {
        new() { TitleEn = "Executive", DescFa = "خلاصه مدیریتی و امتیاز کلی" },
        new() { TitleEn = "Score & Grade", DescFa = "امتیاز، گرید و نمودار" },
        new() { TitleEn = "Risk Assessment", DescFa = "ارزیابی ریسک و سطح بحرانی" },
        new() { TitleEn = "Technical Findings Table", DescFa = "جدول کامل یافته‌ها" },
        new() { TitleEn = "Current vs Expected", DescFa = "مقایسه مقدار فعلی و مورد انتظار" },
        new() { TitleEn = "Registry Snapshots", DescFa = "Snapshot کلیدهای رجیستری" },
        new() { TitleEn = "Evidence Before/After Diff", DescFa = "تفاوت خروجی قبل و بعد" },
        new() { TitleEn = "Command Outputs", DescFa = "خروجی دستورات جمع‌آوری" },
        new() { TitleEn = "Raw Scan Logs", DescFa = "لاگ خام اسکن" },
        new() { TitleEn = "File Hashes (SHA-256)", DescFa = "هش فایل‌های خروجی" },
        new() { TitleEn = "Compliance CIS Mapping", DescFa = "انطباق با CIS Benchmark" },
        new() { TitleEn = "SLA Status", DescFa = "وضعیت SLA و مهلت اصلاح" },
        new() { TitleEn = "Exception/Waiver Record", DescFa = "استثنائات و معافیت‌ها" },
        new() { TitleEn = "Remediation Actions Applied", DescFa = "اقدامات اصلاحی انجام شده" },
        new() { TitleEn = "Remaining Risks", DescFa = "ریسک‌های باقی‌مانده" },
        new() { TitleEn = "Recommendations", DescFa = "پیشنهادات و راهکارها" },
        new() { TitleEn = "Attachments Screenshots", DescFa = "اسکرین‌شات از سیستم" },
        new() { TitleEn = "Baseline Config", DescFa = "فایل پیکربندی بیس‌لاین" },
        new() { TitleEn = "Activity Log", DescFa = "لاگ فعالیت‌های انجام شده" },
        new() { TitleEn = "Approval & Sign-off", DescFa = "تأیید و امضای گزارش" }
    };

    private void SelectAllSections() => Sections.ForEach(s => s.Enabled = true);
    private void DeselectAllSections() => Sections.ForEach(s => s.Enabled = false);

    private string PersianDate
    {
        get
        {
            var pc = new PersianCalendar();
            var now = DateTime.Now;
            return $"{pc.GetYear(now)}/{pc.GetMonth(now):00}/{pc.GetDayOfMonth(now):00}";
        }
    }

    private int EstimatedPages => 4 + Sections.Count(s => s.Enabled) / 2;

    private GateDecision CurrentGate => GateService.EvaluateCurrentState(StateService.CurrentScanResult);

    private void SelectCurrentType()
    {
        if (CurrentGate.Kind != GateKind.Locked)
            SelectedReportType = "current";
    }
    private void SelectBeforeAfterType() => SelectedReportType = "beforeafter";
    private void SelectRemediationType() => SelectedReportType = "remediation";

    // ═══════════════════════════════════════════════════════════
    // Phase 16.3: Custom Templates State
    // ═══════════════════════════════════════════════════════════
    private List<ISCM.Application.Reporting.ReportTemplate> _templates = new();
    private ISCM.Application.Reporting.ReportTemplate? _selectedTemplate;
    private bool _isLoadingTemplates = true;
    private string _newTemplateName = "";
    private string _newTemplateDescription = "";

    // ── Phase 15.4: Snapshot Comparison State ──
    private List<ScanHistoryEntry> SnapshotHistory { get; set; } = new();
    private string SelectedSourceId { get; set; } = "";
    private string SelectedTargetId { get; set; } = "";
    private bool _isComparing;
    private SnapshotDiffResult? _diffResult;
    private string? _compareError;

    private bool CanCompare =>
        !string.IsNullOrEmpty(SelectedSourceId) &&
        !string.IsNullOrEmpty(SelectedTargetId) &&
        SelectedSourceId != SelectedTargetId;

    private async Task RefreshSnapshots()
    {
        await HistoryService.LoadFromPersistenceAsync();
        SnapshotHistory = HistoryService.History.ToList();
        _diffResult = null;
        _compareError = null;
    }

    private async Task CompareSnapshots()
    {
        if (!CanCompare) return;

        _isComparing = true;
        _diffResult = null;
        _compareError = null;

        try
        {
            var sourceId = Guid.Parse(SelectedSourceId);
            var targetId = Guid.Parse(SelectedTargetId);

            var sourceSnapshot = await SnapshotRepository.GetAsync(sourceId);
            var targetSnapshot = await SnapshotRepository.GetAsync(targetId);

            if (sourceSnapshot == null || targetSnapshot == null)
            {
                _compareError = "One or both snapshots could not be loaded from the repository.";
                return;
            }

            _diffResult = await DiffEngine.CompareAsync(sourceSnapshot, targetSnapshot);
        }
        catch (Exception ex)
        {
            _compareError = $"Comparison failed: {ex.Message}";
        }
        finally
        {
            _isComparing = false;
        }
    }

    // ── Phase 15.5: Export/Import State ──
    private bool _isImporting;
    private Guid? _exportingSnapshotId;
    private List<SnapshotImportResult> _importResults = new();
    private string? _exportMessage;
    private string? _exportError;
    private InputFile? _fileInput;

    private void TriggerImportFileDialog()
    {
        _importResults.Clear();
    }

    private async Task OnFilesSelected(InputFileChangeEventArgs e)
    {
        _isImporting = true;
        _importResults.Clear();
        _exportMessage = null;
        _exportError = null;

        try
        {
            var files = e.GetMultipleFiles(10);
            var filePaths = new List<string>();

            foreach (var file in files)
            {
                var tempPath = System.IO.Path.Combine(System.IO.Path.GetTempPath(), file.Name);
                using (var stream = file.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024))
                {
                    using (var fileStream = System.IO.File.Create(tempPath))
                    {
                        await stream.CopyToAsync(fileStream);
                    }
                }
                filePaths.Add(tempPath);
            }

            if (filePaths.Any())
            {
                var results = await ExportService.ImportMultipleAsync(filePaths, "Admin");
                _importResults = results.ToList();

                foreach (var path in filePaths)
                {
                    try { System.IO.File.Delete(path); } catch { }
                }

                await RefreshSnapshots();

                StateService.LogAction($"Imported {_importResults.Count(r => r.Status == SnapshotImportStatus.Success)} snapshot(s), {_importResults.Count(r => r.Status == SnapshotImportStatus.Duplicate)} duplicate(s)");
            }
        }
        catch (Exception ex)
        {
            _importResults.Add(SnapshotImportResult.Failed("batch", $"Import error: {ex.Message}"));
        }
        finally
        {
            _isImporting = false;
        }
    }

    private async Task ExportSnapshotAsync(Guid? snapshotId)
    {
        if (snapshotId == null) return;

        _exportingSnapshotId = snapshotId;
        _exportMessage = null;
        _exportError = null;

        try
        {
            var outputDir = System.IO.Path.Combine(AppContext.BaseDirectory, "Exports");
            var filePath = await ExportService.ExportSnapshotAsync(snapshotId.Value, outputDir, "Admin");

            _exportMessage = $"Snapshot exported to: {filePath}";
            StateService.LogAction($"Snapshot exported: {System.IO.Path.GetFileName(filePath)}");
        }
        catch (Exception ex)
        {
            _exportError = $"Export failed: {ex.Message}";
        }
        finally
        {
            _exportingSnapshotId = null;
        }
    }

    private void ClearImportResults()
    {
        _importResults.Clear();
    }

    // ═══════════════════════════════════════════════════════════
    // Phase 16.3: Template Management Methods
    // ═══════════════════════════════════════════════════════════
    private async Task LoadTemplatesAsync()
    {
        _isLoadingTemplates = true;
        try
        {
            _templates = (await TemplateService.ListTemplatesAsync()).ToList();
            if (_templates.Count > 0 && _selectedTemplate == null)
            {
                _selectedTemplate = _templates[0];
                ApplyTemplate(_selectedTemplate);
            }
        }
        catch (Exception ex)
        {
            StateService.LogAction($"Failed to load templates: {ex.Message}");
        }
        finally
        {
            _isLoadingTemplates = false;
        }
    }

    private void ApplyTemplate(ISCM.Application.Reporting.ReportTemplate template)
    {
        if (template == null) return;
        
        // Apply section configurations
        foreach (var section in template.Sections)
        {
            var uiSection = Sections.FirstOrDefault(s => 
                s.TitleEn.Equals(section.TitleEn, StringComparison.OrdinalIgnoreCase));
            if (uiSection != null)
            {
                uiSection.Enabled = section.Enabled;
            }
        }
        
        // Apply format preference
        SelectedFormat = template.PreferredFormat;
        
        // Apply export options
        OptRawEvidence = template.IncludeRawEvidence;
        OptHashes = template.IncludeFileHashes;
        OptBilingual = template.IsBilingual;
        
        StateService.LogAction($"Applied template: {template.Name}");
    }

    private async Task SaveCurrentAsTemplateAsync()
    {
        if (string.IsNullOrWhiteSpace(_newTemplateName))
        {
            _errorMessage = "Template name is required.";
            return;
        }
        
        try
        {
            var options = new ISCM.Application.Reporting.ReportGenerationOptions
            {
                IncludeExecutiveSummary = Sections.Any(s => s.TitleEn == "Executive" && s.Enabled),
                IncludeTechnicalFindings = Sections.Any(s => s.TitleEn == "Technical Findings Table" && s.Enabled),
                IncludeRiskAssessment = Sections.Any(s => s.TitleEn == "Risk Assessment" && s.Enabled),
                IncludeBeforeAfterComparison = OptBeforeAfter,
                IncludeRawEvidence = OptRawEvidence,
                IncludeFileHashes = OptHashes,
                IsBilingual = OptBilingual
            };
            
            var template = TemplateService.CreateFromOptions(
                _newTemplateName,
                _newTemplateDescription,
                options,
                "User"
            );
            
            await TemplateService.SaveTemplateAsync(template);
            await LoadTemplatesAsync();
            
            _newTemplateName = "";
            _newTemplateDescription = "";
            _errorMessage = null;
            
            StateService.LogAction($"Template saved: {template.Name}");
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to save template: {ex.Message}";
        }
    }

    private async Task DeleteTemplateAsync(string templateId)
    {
        try
        {
            var deleted = await TemplateService.DeleteTemplateAsync(templateId);
            if (deleted)
            {
                await LoadTemplatesAsync();
                StateService.LogAction($"Template deleted: {templateId}");
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to delete template: {ex.Message}";
        }
    }

    // ── Report Generation ──
    private async Task GenerateReportAsync()
    {
        var scan = StateService.CurrentScanResult;
        if (scan == null) { _errorMessage = "No scan data available."; return; }

        if (SelectedReportType == "current")
        {
            var decision = GateService.EvaluateCurrentState(scan);
            if (decision.Kind == GateKind.Locked || decision.Kind == GateKind.Blocked)
            {
                _errorMessage = decision.Message;
                _savedFilePath = null;
                return;
            }
        }

        if (SelectedReportType == "beforeafter")
        {
            var history = HistoryService?.History.ToList() ?? new List<ScanHistoryEntry>();
            if (history.Count < 2)
            {
                _errorMessage = "Before/After report requires at least 2 scans in history.";
                _savedFilePath = null;
                return;
            }
        }

        _isExporting = true;
        _errorMessage = null;
        _savedFilePath = null;

        try
        {
            string outputDir = System.IO.Path.Combine(AppContext.BaseDirectory, "Reports");
            var fullName = GateService.BuildFileName(scan, SelectedReportType, SelectedFormat);
            var baseNoExt = System.IO.Path.GetFileNameWithoutExtension(fullName);

            // ═══════════════════════════════════════════════════════════
            // Phase 16.1: Map UI toggles to ReportGenerationOptions
            // ═══════════════════════════════════════════════════════════
            var options = new ISCM.Application.Reporting.ReportGenerationOptions
                {
                    IncludeExecutiveSummary = Sections.Any(s => s.TitleEn == "Executive" && s.Enabled),
                    IncludeTechnicalFindings = Sections.Any(s => s.TitleEn == "Technical Findings Table" && s.Enabled),
                    IncludeRiskAssessment = Sections.Any(s => s.TitleEn == "Risk Assessment" && s.Enabled),
                    IncludeBeforeAfterComparison = OptBeforeAfter,
                    IncludeRawEvidence = OptRawEvidence,
                    IncludeFileHashes = OptHashes,
                    IsBilingual = OptBilingual,
                    EncryptOutput = OptEncrypt
                };

            _savedFilePath = SelectedFormat switch
            {
                "html" => await ReportService.GenerateAndSaveReportAsync(scan, outputDir, baseNoExt),
                "json" => await ReportService.GenerateAndSaveJsonReportAsync(scan, outputDir, baseNoExt),
                "csv" => await ReportService.GenerateAndSaveCsvReportAsync(scan, outputDir, baseNoExt),
                // ── NEW Phase 16.1 Formats ──
                "pdf" => await ReportService.GeneratePdfReportAsync(scan, outputDir, baseNoExt, options),
                "excel" => await ReportService.GenerateExcelReportAsync(scan, outputDir, baseNoExt, options),
                "zip" => await ReportService.GenerateZipBundleAsync(scan, outputDir, baseNoExt, options),
                _ => null
            };

            if (_savedFilePath == null)
            {
                _errorMessage = $"Unknown format: {SelectedFormat}";
            }
            else
            {
                GateService.RecordReport(scan, SelectedReportType, SelectedFormat, _savedFilePath);
                StateService.LogAction($"Report generated: type={SelectedReportType}, format={SelectedFormat}");
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to generate report: {ex.Message}";
        }
        finally
        {
            _isExporting = false;
        }
    }

    private void PreviewReport() => StateService.LogAction($"Report preview requested: type={SelectedReportType}");
    private void EmailReport() => StateService.LogAction("Email report: planned for a future step.");
    private void ScheduleReport() => StateService.LogAction("Schedule recurring report: planned for a future step.");

    protected override async Task OnInitializedAsync()
    {
        StateService.OnChange += HandleStateChanged;
        await RefreshSnapshots();
        await LoadTemplatesAsync();
    }

    private void HandleStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        StateService.OnChange -= HandleStateChanged;
    }
}