@page "/findings"
@rendermode InteractiveServer
@using System.Text
@using Microsoft.JSInterop
@using ISCM.Domain.Entities
@using ISCM.Domain.Enums
@using ISCM.Web.Services
@using ISCM.Application.Interfaces
@inject ScanStateService StateService
@inject IJSRuntime JS
@inject IControlEvaluator ControlEvaluator
@inject IRemediationService RemediationService
@implements IDisposable

<PageTitle>DefenDoor - Findings</PageTitle>

<style>
    .glass-panel {
        background: rgba(30,41,59,0.7);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 8px 32px 0 rgba(0,0,0,0.37);
        display: flex;
        flex-direction: column;
        overflow: hidden;
        box-sizing: border-box;
    }

    .stats-tabs {
        display: flex;
        gap: 12px;
        margin-bottom: 16px;
        flex-wrap: wrap;
    }

    .stat-tab {
        background: rgba(15,23,42,0.6);
        border: 1px solid #334155;
        border-radius: 10px;
        padding: 14px 20px;
        cursor: pointer;
        transition: 0.2s;
        min-width: 140px;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

        .stat-tab:hover {
            border-color: #06b6d4;
            transform: translateY(-2px);
        }

        .stat-tab.active {
            border-color: #06b6d4;
            background: rgba(6,182,212,0.12);
            box-shadow: 0 0 12px rgba(6,182,212,0.2);
        }

    .stat-value {
        font-size: 28px;
        font-weight: 800;
        font-family: 'Consolas', monospace;
        color: #e2e8f0;
        line-height: 1;
    }

    .stat-label {
        font-size: 11px;
        color: #94a3b8;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .stat-tab.all { border-left: 4px solid #06b6d4; }
    .stat-tab.baseline { border-left: 4px solid #8b5cf6; }
    .stat-tab.extended { border-left: 4px solid #0891b2; }
    .stat-tab.fail { border-left: 4px solid #ef4444; }
    .stat-tab.pass { border-left: 4px solid #10b981; }
    .stat-tab.unknown { border-left: 4px solid #f59e0b; }

    .search-wrap {
        position: relative;
        margin-bottom: 14px;
    }

    .search-icon {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        pointer-events: none;
    }

    .search-box {
        background: #0f172a;
        border: 1px solid #334155;
        padding: 10px 15px 10px 36px;
        border-radius: 6px;
        color: white;
        width: 100%;
        box-sizing: border-box;
        font-size: 13px;
    }

        .search-box::placeholder {
            color: #64748b;
        }

    .bulk-bar {
        display: none;
        gap: 10px;
        align-items: center;
        background: rgba(6,182,212,0.08);
        border: 1px solid rgba(6,182,212,0.3);
        border-radius: 8px;
        padding: 8px 14px;
        margin-bottom: 12px;
    }

        .bulk-bar.visible {
            display: flex;
        }

    .bulk-count {
        color: #06b6d4;
        font-family: 'Consolas', monospace;
        font-weight: bold;
        font-size: 13px;
    }

    .bulk-btn {
        background: #1e293b;
        border: 1px solid #334155;
        color: #e2e8f0;
        font-size: 11px;
        padding: 5px 12px;
        border-radius: 4px;
        cursor: pointer;
        transition: 0.2s;
    }

        .bulk-btn:hover {
            border-color: #06b6d4;
        }

        .bulk-btn.clear {
            margin-left: auto;
            background: transparent;
            color: #94a3b8;
        }

    .category-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
    }

    .cat-links {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
    }

    .cat-link {
        background: none;
        border: none;
        color: #64748b;
        font-size: 12px;
        font-weight: bold;
        cursor: pointer;
        padding: 4px 2px;
        transition: 0.2s;
    }

        .cat-link:hover {
            color: #94a3b8;
        }

        .cat-link.active {
            color: #e2e8f0;
        }

    .btn-back {
        background: #334155;
        border: none;
        padding: 8px 20px;
        color: #06b6d4;
        font-weight: bold;
        border-radius: 6px;
        cursor: pointer;
        text-decoration: none;
        font-size: 12px;
    }

    .findings-list {
        flex-grow: 1;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 10px;
        scrollbar-width: thin;
        scrollbar-color: #164e63 #0f172a;
    }

    .finding-card {
        display: flex;
        align-items: center;
        gap: 14px;
        background: rgba(15,23,42,0.6);
        border: 1px solid #1e293b;
        border-left: 3px solid #334155;
        border-radius: 8px;
        padding: 12px 14px;
        cursor: pointer;
        transition: 0.2s;
        flex-wrap: wrap;
    }

        .finding-card:hover {
            background: rgba(6,182,212,0.05);
            border-color: #06b6d4;
        }

        .finding-card.selected {
            background: rgba(6,182,212,0.08);
            border-color: #06b6d4;
        }

    .border-pass { border-left-color: #10b981 !important; }
    .border-fail { border-left-color: #ef4444 !important; }
    .border-warning { border-left-color: #f59e0b !important; }
    .border-ignored { border-left-color: #94a3b8 !important; }
    .border-error { border-left-color: #dc2626 !important; }
    .border-falsepositive { border-left-color: #a78bfa !important; }
    .border-unknown { border-left-color: #f59e0b !important; }

    .finding-checkbox {
        width: 14px;
        height: 14px;
        border: 2px solid #475569;
        border-radius: 3px;
        cursor: pointer;
        flex-shrink: 0;
        transition: 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
    }

        .finding-checkbox.checked {
            background: #06b6d4;
            border-color: #06b6d4;
        }

            .finding-checkbox.checked::after {
                content: "✓";
                color: white;
                font-weight: bold;
            }

    .finding-main {
        flex: 1 1 260px;
        min-width: 0;
        cursor: pointer;
    }

    .finding-title-row {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .finding-name {
        color: #e2e8f0;
        font-weight: bold;
        font-size: 13px;
    }

    .finding-id {
        color: #64748b;
        font-family: 'Consolas', monospace;
        font-size: 11px;
    }

    .cis-badge {
        color: #0891b2;
        border: 1px solid rgba(8,145,178,0.4);
        background: rgba(8,145,178,0.08);
        font-family: 'Consolas', monospace;
        font-size: 10px;
        padding: 2px 8px;
        border-radius: 4px;
    }

    .fp-tag {
        color: #a78bfa;
        border: 1px solid rgba(167,139,250,0.4);
        background: rgba(167,139,250,0.1);
        font-family: 'Consolas', monospace;
        font-size: 10px;
        padding: 2px 6px;
        border-radius: 3px;
        font-weight: bold;
    }

    .ignored-badge {
        color: #94a3b8;
        border: 1px solid rgba(148,163,184,0.4);
        background: rgba(148,163,184,0.1);
        font-family: 'Consolas', monospace;
        font-size: 10px;
        padding: 2px 6px;
        border-radius: 3px;
        font-weight: bold;
    }

    .mndchi-badge {
        color: #8b5cf6;
        border: 1px solid rgba(139,92,246,0.4);
        background: rgba(139,92,246,0.1);
        font-family: 'Consolas', monospace;
        font-size: 10px;
        padding: 2px 6px;
        border-radius: 3px;
        font-weight: bold;
    }

    .finding-source {
        color: #64748b;
        font-size: 11px;
        margin-top: 4px;
        font-family: 'Consolas', monospace;
    }

    .finding-badges {
        display: flex;
        gap: 6px;
        align-items: center;
        flex-wrap: wrap;
    }

    .status-pass { color: #10b981; font-weight: bold; background: rgba(16,185,129,0.1); padding: 4px 8px; border-radius: 4px; font-size: 10px; }
    .status-fail { color: #ef4444; font-weight: bold; background: rgba(239,68,68,0.1); padding: 4px 8px; border-radius: 4px; font-size: 10px; }
    .status-warning { color: #f59e0b; font-weight: bold; background: rgba(245,158,11,0.1); padding: 4px 8px; border-radius: 4px; font-size: 10px; }
    .status-ignored { color: #94a3b8; font-weight: bold; background: rgba(148,163,184,0.1); padding: 4px 8px; border-radius: 4px; font-size: 10px; }
    .status-error { color: #dc2626; font-weight: bold; background: rgba(220,38,38,0.1); padding: 4px 8px; border-radius: 4px; font-size: 10px; }
    .status-falsepositive { color: #a78bfa; font-weight: bold; background: rgba(167,139,250,0.1); padding: 4px 8px; border-radius: 4px; font-size: 10px; }
    .status-unknown { color: #f59e0b; font-weight: bold; background: rgba(245,158,11,0.1); padding: 4px 8px; border-radius: 4px; font-size: 10px; }

    .sev-badge {
        font-size: 10px;
        font-weight: bold;
        padding: 3px 8px;
        border-radius: 4px;
        text-transform: uppercase;
    }

        .sev-badge.low { color: #94a3b8; background: rgba(148,163,184,0.12); }
        .sev-badge.medium { color: #e2e8f0; background: rgba(226,232,240,0.12); }
        .sev-badge.high { color: #f59e0b; background: rgba(245,158,11,0.12); }
        .sev-badge.critical { color: #ef4444; background: rgba(239,68,68,0.15); }

    .empty-state {
        color: #64748b;
        text-align: center;
        padding: 40px;
        font-size: 13px;
    }

    .finding-wrap {
        display: flex;
        flex-direction: column;
    }

    .sub-toggle {
        background: rgba(6,182,212,0.1);
        border: 1px solid rgba(6,182,212,0.4);
        color: #06b6d4;
        font-size: 9px;
        font-weight: bold;
        font-family: 'Consolas', monospace;
        padding: 3px 8px;
        border-radius: 4px;
        cursor: pointer;
        flex-shrink: 0;
    }

    /* Phase 15.2: Tree View Styles */
    .tree-view {
        margin: 10px 0 10px 24px;
        border-left: 2px solid #334155;
        padding-left: 12px;
    }

    .tree-node { margin-bottom: 8px; }
    .tree-branch { margin-bottom: 6px; }

    .tree-branch-header {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 12px;
        background: rgba(15, 23, 42, 0.8);
        border: 1px solid #334155;
        border-radius: 6px;
        cursor: pointer;
        transition: 0.2s;
    }

        .tree-branch-header:hover {
            border-color: #06b6d4;
            background: rgba(6, 182, 212, 0.06);
        }

    .tree-icon {
        color: #06b6d4;
        font-family: 'Consolas', monospace;
        font-size: 12px;
        width: 12px;
    }

    .tree-leaves {
        margin: 6px 0 6px 20px;
        border-left: 1px dashed #475569;
        padding-left: 12px;
    }

    .tree-leaf {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 6px 10px;
        background: rgba(15, 23, 42, 0.6);
        border: 1px solid #1e293b;
        border-radius: 4px;
        margin-bottom: 4px;
        cursor: pointer;
        transition: 0.2s;
        font-size: 11px;
    }

        .tree-leaf:hover {
            border-color: #06b6d4;
            background: rgba(6, 182, 212, 0.04);
        }

    .evidence-icon { font-size: 10px; }

    .evidence-source {
        color: #06b6d4;
        font-family: 'Consolas', monospace;
        font-size: 10px;
        font-weight: bold;
        min-width: 80px;
    }

    .evidence-value {
        color: #e2e8f0;
        font-family: 'Consolas', monospace;
        font-size: 11px;
        flex: 1;
    }

    .evidence-status {
        font-size: 9px;
        padding: 2px 6px;
        border-radius: 3px;
        font-weight: bold;
    }

    .evidence-lifecycle {
        color: #64748b;
        font-size: 9px;
        font-family: 'Consolas', monospace;
    }

    .subcheck-id {
        color: #06b6d4;
        font-family: 'Consolas', monospace;
        font-size: 9px;
        font-weight: bold;
        flex-shrink: 0;
    }

    .subcheck-title {
        color: #e2e8f0;
        font-size: 11px;
        font-weight: bold;
    }

    .evidence-count {
        color: #64748b;
        font-size: 9px;
        margin-left: auto;
    }

    /* Phase 4.4: Remediate Button */
    .remediate-btn {
        background: #10b981;
        color: white;
        border: none;
        font-size: 11px;
        font-weight: bold;
        padding: 5px 12px;
        border-radius: 4px;
        cursor: pointer;
        transition: 0.2s;
        display: flex;
        align-items: center;
        gap: 4px;
    }

        .remediate-btn:hover {
            background: #059669;
            transform: translateY(-1px);
        }

    /* Phase 4.4: Modal Base */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0,0,0,0.7);
        z-index: 1000;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .modal-content {
        background: #1e293b;
        border: 1px solid #06b6d4;
        border-radius: 12px;
        padding: 24px;
        max-width: 500px;
        width: 90%;
        box-shadow: 0 0 30px rgba(6,182,212,0.3);
    }

    .modal-title {
        color: #06b6d4;
        margin-bottom: 16px;
        font-family: 'Consolas', monospace;
        font-size: 18px;
    }

    .modal-field {
        margin-bottom: 12px;
    }

    .modal-label {
        color: #94a3b8;
        font-weight: bold;
        font-size: 12px;
    }

    .modal-value {
        color: #e2e8f0;
        font-size: 13px;
        margin-top: 4px;
    }

    .modal-warning {
        color: #f59e0b;
        background: rgba(245,158,11,0.1);
        padding: 8px;
        border-radius: 4px;
        margin-bottom: 12px;
        font-size: 12px;
    }

    .modal-actions {
        display: flex;
        gap: 12px;
        justify-content: flex-end;
        margin-top: 20px;
    }

    .modal-btn-cancel {
        background: #475569;
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 6px;
        cursor: pointer;
        font-weight: bold;
    }

    .modal-btn-confirm {
        background: #10b981;
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 6px;
        cursor: pointer;
        font-weight: bold;
    }

        .modal-btn-confirm:hover {
            background: #059669;
        }

    /* Phase 15.3: Wizard Styles */
    .wizard-modal {
        max-width: 700px;
        min-height: 450px;
    }

    .wizard-header {
        margin-bottom: 20px;
    }

    .wizard-steps {
        display: flex;
        gap: 8px;
        margin-top: 12px;
    }

    .wizard-step {
        flex: 1;
        padding: 6px 12px;
        background: #1e293b;
        border-radius: 4px;
        text-align: center;
        font-size: 11px;
        color: #64748b;
    }

    .wizard-step.active {
        background: #06b6d4;
        color: white;
    }

    .remediation-option {
        background: #0f172a;
        border: 2px solid #334155;
        border-radius: 8px;
        padding: 12px;
        margin-bottom: 10px;
        cursor: pointer;
        transition: 0.2s;
    }

    .remediation-option:hover,
    .remediation-option.selected {
        border-color: #06b6d4;
        background: rgba(6, 182, 212, 0.1);
    }

    .rem-title {
        color: #e2e8f0;
        font-weight: bold;
        font-size: 14px;
        margin-bottom: 4px;
    }

    .rem-desc {
        color: #94a3b8;
        font-size: 12px;
        margin-bottom: 8px;
    }

    .rem-meta {
        display: flex;
        gap: 8px;
        align-items: center;
        font-size: 11px;
        color: #64748b;
    }

    .reboot-badge {
        background: rgba(245, 158, 11, 0.2);
        color: #f59e0b;
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 10px;
    }

    .validation-pass { color: #10b981; font-weight: bold; }
    .validation-fail { color: #ef4444; font-weight: bold; }
    .validation-warnings { color: #f59e0b; font-weight: bold; margin-top: 12px; }

    .error-list, .warning-list { margin: 4px 0 0 20px; font-size: 12px; }
    .error-list li { color: #ef4444; }
    .warning-list li { color: #f59e0b; }

    .confirm-details {
        background: #0f172a;
        border: 1px solid #334155;
        border-radius: 8px;
        padding: 12px;
        line-height: 1.8;
    }

    .backup-notice {
        margin-top: 12px;
        padding: 8px;
        background: rgba(6, 182, 212, 0.1);
        border-left: 3px solid #06b6d4;
        font-size: 12px;
    }

    .loading {
        text-align: center;
        padding: 30px;
        color: #94a3b8;
    }

    .spinner {
        width: 36px;
        height: 36px;
        border: 4px solid #334155;
        border-top-color: #06b6d4;
        border-radius: 50%;
        animation: spin 1s linear infinite;
        margin: 0 auto 12px;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }

    .result-status {
        text-align: center;
        padding: 16px;
        border-radius: 8px;
        margin-bottom: 12px;
    }

    .result-status.success {
        background: rgba(16, 185, 129, 0.1);
        border: 1px solid rgba(16, 185, 129, 0.3);
    }

    .result-status.failed {
        background: rgba(239, 68, 68, 0.1);
        border: 1px solid rgba(239, 68, 68, 0.3);
    }

    .result-icon { font-size: 40px; margin-bottom: 6px; }
    .result-text { font-size: 14px; font-weight: bold; color: #e2e8f0; }

    .execution-output {
        background: #0f172a;
        border: 1px solid #334155;
        border-radius: 8px;
        padding: 12px;
        margin-bottom: 12px;
    }

    .execution-output pre {
        margin: 8px 0 0 0;
        color: #94a3b8;
        font-size: 11px;
        white-space: pre-wrap;
        word-break: break-all;
    }
</style>

<div class="glass-panel">
    <div class="stats-tabs">
        <div class="stat-tab all @(SelectedFilter == "All" ? "active" : "")" @onclick="SetFilterAll">
            <div class="stat-value">@CountAll</div>
            <div class="stat-label">All Controls</div>
        </div>
        <div class="stat-tab baseline @(SelectedFilter == "Baseline" ? "active" : "")" @onclick="SetFilterBaseline">
            <div class="stat-value">@CountBaseline</div>
            <div class="stat-label">Baseline</div>
        </div>
        <div class="stat-tab extended @(SelectedFilter == "Extended" ? "active" : "")" @onclick="SetFilterExtended">
            <div class="stat-value">@CountExtended</div>
            <div class="stat-label">Extended</div>
        </div>
        <div class="stat-tab fail @(SelectedFilter == "Fail" ? "active" : "")" @onclick="SetFilterFail">
            <div class="stat-value">@CountFail</div>
            <div class="stat-label">Fail</div>
        </div>
        <div class="stat-tab pass @(SelectedFilter == "Pass" ? "active" : "")" @onclick="SetFilterPass">
            <div class="stat-value">@CountPass</div>
            <div class="stat-label">Pass</div>
        </div>
        <div class="stat-tab unknown @(SelectedFilter == "Unknown" ? "active" : "")" @onclick="SetFilterUnknown">
            <div class="stat-value">@CountUnknown</div>
            <div class="stat-label">Unknown</div>
        </div>
    </div>

    <div class="search-wrap">
        <span class="search-icon">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" stroke-linecap="round">
                <circle cx="11" cy="11" r="7" />
                <line x1="21" y1="21" x2="16.5" y2="16.5" />
            </svg>
        </span>
        <input type="text" class="search-box" placeholder="Search findings..." @bind="SearchTerm" @bind:event="oninput" />
    </div>

    <div class="bulk-bar @(SelectedFindingIds.Count > 0 ? "visible" : "")">
        <span class="bulk-count">@SelectedFindingIds.Count selected</span>
        <button class="bulk-btn" @onclick="BulkRescan">🔄 Rescan</button>
        <button class="bulk-btn" @onclick="BulkIgnore">🚫 Ignore</button>
        <button class="bulk-btn" @onclick="BulkMarkFp">🏳️ Mark FP</button>
        <button class="bulk-btn" @onclick="BulkExport">📤 Export Selected</button>
        <button class="bulk-btn clear" @onclick="ClearSelection">Clear All</button>
    </div>

    @if (!string.IsNullOrEmpty(_remediationNotice))
    {
        <div style="@NoticeStyle padding:10px 14px; border-radius:6px; margin-bottom:12px; display:flex; justify-content:space-between; align-items:center; font-size:12px; font-weight:bold;">
            <span>@_remediationNotice</span>
            <button class="bulk-btn" @onclick="() => _remediationNotice = null">✕</button>
        </div>
    }

    <div class="category-row">
        <div class="cat-links">
            <button class="cat-link @(string.IsNullOrEmpty(SelectedCategory) ? "active" : "")" @onclick="ClearCategory">All Categories</button>
            @foreach (var cat in AllCategories)
            {
                var capturedCat = cat;
                <button class="cat-link @(SelectedCategory == capturedCat ? "active" : "")" @onclick="() => SetCategory(capturedCat)">@capturedCat</button>
            }
        </div>
        <a href="/" class="btn-back">← Back to Dashboard</a>
    </div>

    @if (StateService.CurrentScanResult == null)
    {
        <p class="empty-state">Run a scan from the Dashboard to see findings.</p>
    }
    else if (!FilteredParents.Any())
    {
        <p class="empty-state">No controls match the current filters.</p>
    }
    else
    {
        <div class="findings-list">
            @foreach (var parent in FilteredParents)
            {
                var isExpanded = ExpandedIds.Contains(parent.Definition.ControlId);
                <div class="finding-wrap">
                    <div class="finding-card border-@parent.CalculatedStatus.ToString().ToLower() @(IsSelected(parent) ? "selected" : "")">
                        <div class="finding-checkbox @(IsSelected(parent) ? "checked" : "")"
                             @onclick="() => ToggleSelect(parent)"
                             @onclick:stopPropagation="true"></div>
                        <div class="finding-main" @onclick="() => ToggleExpanded(parent.Definition.ControlId)">
                            <div class="finding-title-row">
                                <span class="finding-name">@parent.Definition.ControlId. @parent.Definition.Title</span>
                                @if (parent.Definition.IsBaseline)
                                {
                                    <span class="mndchi-badge">@parent.Definition.BaselineId</span>
                                }
                                else
                                {
                                    <span class="cis-badge">Extended</span>
                                }
                            </div>
                            <div class="finding-source">@parent.Definition.Description</div>
                        </div>
                        <div class="finding-badges">
                            <span class="status-@parent.CalculatedStatus.ToString().ToLower()">@parent.CalculatedStatus</span>
                            <span class="sev-badge @parent.Definition.Severity.ToString().ToLower()">@parent.Definition.Severity</span>
                        </div>
                        @if (parent.AllSubChecks.Any())
                        {
                            <button class="sub-toggle" @onclick="() => ToggleExpanded(parent.Definition.ControlId)" @onclick:stopPropagation="true">
                                @(isExpanded ? "▾" : "▸") @parent.AllSubChecks.Count sub
                            </button>
                        }

                        @if (parent.CalculatedStatus == CheckStatus.Fail)
                        {
                            var availableRemediations = parent.Definition.TechnicalCheckIds
                            .SelectMany(checkId => RemediationService.GetRemediationsForCheck(checkId))
                            .ToList();

                            if (availableRemediations.Any())
                            {
                                <button class="remediate-btn"
                                        @onclick="() => OpenRemediationWizard(parent, availableRemediations)"
                                        @onclick:stopPropagation="true"
                                        title="Remediate this finding">
                                    🔧 Remediate
                                </button>
                            }
                        }
                    </div>

                    @* Phase 15.2: Tree View for Evidence *@
                    @if (isExpanded && parent.Findings.Any())
                    {
                        <div class="tree-view">
                            @foreach (var finding in parent.Findings)
                            {
                                var evidenceGroups = finding.Evidences
                                    .GroupBy(e => e.SubControlId ?? finding.CheckId)
                                    .ToList();

                                <div class="tree-node">
                                    @foreach (var group in evidenceGroups)
                                    {
                                        var subControlId = group.Key;
                                        var evidences = group.ToList();
                                        var subCheck = parent.AllSubChecks.FirstOrDefault(s => s.Id == subControlId);
                                        var groupStatus = evidences.All(e => e.Evaluation == CheckStatus.Pass) ? CheckStatus.Pass
                                                        : evidences.Any(e => e.Evaluation == CheckStatus.Fail) ? CheckStatus.Fail
                                                        : evidences.Any(e => e.Evaluation == CheckStatus.Error) ? CheckStatus.Error
                                                        : CheckStatus.Unknown;

                                        <div class="tree-branch">
                                            <div class="tree-branch-header" @onclick="() => ToggleSubControl(subControlId)">
                                                <span class="tree-icon">@(IsSubControlExpanded(subControlId) ? "▾" : "▸")</span>
                                                <span class="subcheck-id">@subControlId</span>
                                                <span class="subcheck-title">@(subCheck?.Title ?? subControlId)</span>
                                                <span class="status-@groupStatus.ToString().ToLower()">@groupStatus</span>
                                                <span class="evidence-count">@evidences.Count evidence@(evidences.Count != 1 ? "s" : "")</span>
                                            </div>

                                            @if (IsSubControlExpanded(subControlId))
                                            {
                                                <div class="tree-leaves">
                                                    @foreach (var evidence in evidences)
                                                    {
                                                        <div class="tree-leaf" @onclick="() => OpenEvidenceDrawer(finding, evidence)">
                                                            <span class="evidence-icon">📄</span>
                                                            <span class="evidence-source">@evidence.SourceType</span>
                                                            <span class="evidence-value">@(evidence.NormalizedValue ?? evidence.ParsedValue ?? "N/A")</span>
                                                            <span class="evidence-status status-@evidence.Evaluation.ToString().ToLower()">@evidence.Evaluation</span>
                                                            <span class="evidence-lifecycle">@evidence.LifecycleState</span>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@* Phase 15.3: Remediation Wizard Modal *@
@if (_showRemediationWizard)
{
    <div class="modal-overlay">
        <div class="modal-content wizard-modal">
            <div class="wizard-header">
                <h3 class="modal-title">🔧 Remediation Wizard</h3>
                <div class="wizard-steps">
                    <span class="wizard-step @(_wizardStep >= 1 ? "active" : "")">1</span>
                    <span class="wizard-step @(_wizardStep >= 2 ? "active" : "")">2</span>
                    <span class="wizard-step @(_wizardStep >= 3 ? "active" : "")">3</span>
                    <span class="wizard-step @(_wizardStep >= 4 ? "active" : "")">4</span>
                    <span class="wizard-step @(_wizardStep >= 5 ? "active" : "")">5</span>
                </div>
            </div>

            @if (_wizardStep == 1 && _availableRemediations.Count > 1)
            {
                <div class="modal-field">
                    <div class="modal-label">Select Remediation:</div>
                    @foreach (var rem in _availableRemediations)
                    {
                        <div class="remediation-option @(_wizardRemediation?.RemediationId == rem.RemediationId ? "selected" : "")"
                             @onclick="() => SelectRemediation(rem)">
                            <div class="rem-title">@rem.Title</div>
                            <div class="rem-desc">@rem.Description</div>
                            <div class="rem-meta">
                                <span class="sev-badge @rem.RiskLevel.ToString().ToLower()">@rem.RiskLevel</span>
                                <span>@rem.Type</span>
                                @if (rem.RequiresReboot)
                                {
                                    <span class="reboot-badge">⚠️ Reboot</span>
                                }
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-actions">
                    <button class="modal-btn-cancel" @onclick="CloseRemediationWizard">Cancel</button>
                    <button class="modal-btn-confirm" @onclick="GoToStep2" disabled="@(_wizardRemediation == null)">Next →</button>
                </div>
            }
            else if (_wizardStep == 2 || (_wizardStep == 1 && _availableRemediations.Count <= 1))
            {
                <div class="modal-field">
                    <div class="modal-label">Pre-flight Validation:</div>
                    @if (_validationResult == null)
                    {
                        <div class="loading"><div class="spinner"></div>Validating...</div>
                    }
                    else if (_validationResult.IsValid)
                    {
                        <div class="validation-pass">✅ All prerequisites met</div>
                        @if (_validationResult.Warnings.Any())
                        {
                            <div class="validation-warnings">⚠️ Warnings:</div>
                            <ul class="warning-list">
                                @foreach (var w in _validationResult.Warnings)
                                {
                                    <li>@w</li>
                                }
                            </ul>
                        }
                    }
                    else
                    {
                        <div class="validation-fail">❌ Validation failed:</div>
                        <ul class="error-list">
                            @foreach (var e in _validationResult.Errors)
                            {
                                <li>@e</li>
                            }
                        </ul>
                    }
                </div>
                <div class="modal-actions">
                    <button class="modal-btn-cancel" @onclick="CloseRemediationWizard">Cancel</button>
                    <button class="modal-btn-confirm" @onclick="GoToStep3" disabled="@(_validationResult == null || !_validationResult.IsValid)">Next →</button>
                </div>
            }
            else if (_wizardStep == 3)
            {
                <div class="modal-field">
                    <div class="modal-label">Confirm Execution:</div>
                    <div class="confirm-details">
                        <div><strong>Action:</strong> @_wizardRemediation?.Title</div>
                        <div><strong>Risk:</strong> <span class="sev-badge @_wizardRemediation?.RiskLevel.ToString().ToLower()">@_wizardRemediation?.RiskLevel</span></div>
                        @if (_wizardRemediation?.RequiresReboot == true)
                        {
                            <div class="modal-warning">⚠️ Requires system reboot.</div>
                        }
                        @if (_wizardRemediation?.Warnings.Any() == true)
                        {
                            <div class="modal-warning">
                                <strong>Warnings:</strong>
                                <ul>@foreach (var w in _wizardRemediation.Warnings) { <li>@w</li> }</ul>
                            </div>
                        }
                        <div class="backup-notice">📦 Backup of current state will be created (Registry only).</div>
                    </div>
                </div>
                <div class="modal-actions">
                    <button class="modal-btn-cancel" @onclick="GoToStep2">← Back</button>
                    <button class="modal-btn-confirm" @onclick="ExecuteWizardRemediation">✅ Execute</button>
                </div>
            }
            else if (_wizardStep == 4)
            {
                <div class="modal-field">
                    <div class="loading"><div class="spinner"></div>Applying changes to the system...</div>
                </div>
            }
            else if (_wizardStep == 5)
            {
                <div class="modal-field">
                    <div class="modal-label">Execution Result:</div>
                    @if (_executionResult != null)
                    {
                        <div class="result-status @(_executionResult.Status == RemediationStatus.Success ? "success" : "failed")">
                            <div class="result-icon">@(_executionResult.Status == RemediationStatus.Success ? "✅" : "❌")</div>
                            <div class="result-text">@(_executionResult.Status == RemediationStatus.Success ? "Success" : "Failed")</div>
                        </div>
                        <div class="execution-output">
                            <strong>Output:</strong>
                            <pre>@_executionResult.ExecutionOutput</pre>
                        </div>
                    }
                </div>
                <div class="modal-actions">
                    @if (_executionResult?.Status == RemediationStatus.Success)
                    {
                        <button class="modal-btn-confirm" @onclick="RescanAfterRemediation">🔄 Rescan</button>
                        @if (_executionResult.CanRollback)
                        {
                            <button class="modal-btn-cancel" @onclick="RollbackRemediation">↶ Rollback</button>
                        }
                    }
                    <button class="modal-btn-cancel" @onclick="CloseRemediationWizard">Close</button>
                </div>
            }
        </div>
    </div>
}

<FindingDrawer SelectedFinding="SelectedFinding" InitialSubCheck="SelectedSub" Close="OnDrawerClose" />

@code {
    private string SelectedFilter = "All";
    private string SearchTerm = "";
    private HashSet<string> SelectedFindingIds = new();
    private Finding? SelectedFinding;

    [SupplyParameterFromQuery(Name = "category")]
    public string? SelectedCategory { get; set; }

    private static readonly List<string> AllCategories =
        Enum.GetValues(typeof(CheckCategory)).Cast<CheckCategory>().Select(c => c.ToString()).ToList();

    private class ParentControlView
    {
        public ControlDefinition Definition { get; set; } = null!;
        public List<Finding> Findings { get; set; } = new();
        public CheckStatus CalculatedStatus { get; set; }
        public List<SubCheck> AllSubChecks { get; set; } = new();
    }

    private string? _remediationNotice;
    private string _noticeKind = "warning";

    private string NoticeStyle => _noticeKind switch
    {
        "success" => "background:rgba(16,185,129,0.12); border:1px solid rgba(16,185,129,0.5); color:#10b981;",
        "error" => "background:rgba(239,68,68,0.12); border:1px solid rgba(239,68,68,0.5); color:#ef4444;",
        _ => "background:rgba(245,158,11,0.12); border:1px solid rgba(245,158,11,0.5); color:#f59e0b;"
    };

    // Phase 15.2: Tree View state management
    private HashSet<string> ExpandedSubControlIds = new();

    private bool IsSubControlExpanded(string id) => ExpandedSubControlIds.Contains(id);

    private void ToggleSubControl(string id)
    {
        if (!ExpandedSubControlIds.Add(id))
            ExpandedSubControlIds.Remove(id);
    }

    private void OpenEvidenceDrawer(Finding finding, Evidence evidence)
    {
        SelectedFinding = finding;
        SelectedSub = null;
    }

    // Phase 15.3: Wizard State
    private bool _showRemediationWizard = false;
    private RemediationAction? _wizardRemediation;
    private List<RemediationAction> _availableRemediations = new();
    private int _wizardStep = 1;
    private RemediationValidationResult? _validationResult;
    private RemediationHistory? _executionResult;
    private ParentControlView? _wizardParent;

    // Phase 15.3: Wizard Methods
    private async Task OpenRemediationWizard(ParentControlView parent, List<RemediationAction> remediations)
    {
        _wizardParent = parent;
        _availableRemediations = remediations;
        _wizardRemediation = remediations.FirstOrDefault();
        _wizardStep = remediations.Count > 1 ? 1 : 2;
        _showRemediationWizard = true;
        _validationResult = null;
        _executionResult = null;

        if (_wizardStep == 2)
        {
            await ValidateCurrentRemediation();
        }
    }

    private void SelectRemediation(RemediationAction rem) => _wizardRemediation = rem;

    private async Task GoToStep2()
    {
        _wizardStep = 2;
        await ValidateCurrentRemediation();
    }

    private async Task ValidateCurrentRemediation()
    {
        if (_wizardRemediation == null) return;
        _validationResult = await RemediationService.ValidateRemediationAsync(_wizardRemediation.RemediationId);
        StateHasChanged();
    }

    private void GoToStep3() => _wizardStep = 3;

    private async Task ExecuteWizardRemediation()
    {
        if (_wizardRemediation == null) return;
        _wizardStep = 4;
        StateHasChanged();

        await Task.Delay(100);

        _executionResult = await RemediationService.ExecuteRemediationAsync(_wizardRemediation.RemediationId, "Admin");
        _wizardStep = 5;

        StateService.LogConsole($"Remediation {_wizardRemediation.Title}: {_executionResult.Status}",
            _executionResult.Status == RemediationStatus.Success ? "status-success" : "status-error");
        StateService.LogAction($"Remediation executed: {_wizardRemediation.Title} - {_executionResult.Status}");
        StateHasChanged();
    }

    private async Task RescanAfterRemediation()
    {
        if (_wizardParent == null || _wizardRemediation == null) return;

        var targetCheckId = _wizardParent.Findings.FirstOrDefault()?.CheckId ?? _wizardRemediation.CheckId;
        if (string.IsNullOrEmpty(targetCheckId)) return;

        await StateService.RescanCheckAsync(targetCheckId);

        _noticeKind = "success";
        _remediationNotice = $"✅ Rescan completed for {targetCheckId}.";
        CloseRemediationWizard();
    }

    private async Task RollbackRemediation()
    {
        if (_wizardRemediation == null) return;

        var rollbackResult = await RemediationService.RollbackRemediationAsync(_wizardRemediation.RemediationId, "Admin");

        _noticeKind = rollbackResult.Status == RemediationStatus.RolledBack ? "success" : "error";
        _remediationNotice = rollbackResult.Status == RemediationStatus.RolledBack
            ? $"↶ Rollback completed for {_wizardRemediation.Title}"
            : $"❌ Rollback failed: {rollbackResult.ExecutionOutput}";

        CloseRemediationWizard();
    }

    private void CloseRemediationWizard()
    {
        _showRemediationWizard = false;
        _wizardRemediation = null;
        _availableRemediations.Clear();
        _wizardStep = 1;
        _validationResult = null;
        _executionResult = null;
        _wizardParent = null;
    }

    private List<ParentControlView> GetParentControls()
    {
        if (StateService.CurrentScanResult == null) return new();

        var allFindings = StateService.CurrentScanResult.Findings.ToList();

        var parents = new List<ParentControlView>();

        foreach (var control in ControlCatalog.GetAll())
        {
            var findings = ControlCatalog.GetFindingsForControl(control, allFindings).ToList();

            if (!findings.Any() && !control.IsBaseline) continue;

            var controlResult = ControlEvaluator.EvaluateFromFindings(control, findings);

            var parent = new ParentControlView
                {
                    Definition = control,
                    Findings = findings,
                    CalculatedStatus = controlResult.Status,
                    AllSubChecks = findings.SelectMany(f => f.SubChecks).ToList()
                };

            parents.Add(parent);
        }

        return parents;
    }

    private List<ParentControlView> FilteredParents
    {
        get
        {
            var parents = GetParentControls();

            if (!string.IsNullOrWhiteSpace(SelectedCategory))
            {
                parents = parents.Where(p => p.Definition.Category.ToString() == SelectedCategory).ToList();
            }

            if (SelectedFilter == "Baseline")
            {
                parents = parents.Where(p => p.Definition.IsBaseline).ToList();
            }
            else if (SelectedFilter == "Extended")
            {
                parents = parents.Where(p => !p.Definition.IsBaseline).ToList();
            }
            else if (SelectedFilter == "Fail")
            {
                parents = parents.Where(p => p.CalculatedStatus == CheckStatus.Fail).ToList();
            }
            else if (SelectedFilter == "Pass")
            {
                parents = parents.Where(p => p.CalculatedStatus == CheckStatus.Pass).ToList();
            }
            else if (SelectedFilter == "Unknown")
            {
                parents = parents.Where(p => p.CalculatedStatus == CheckStatus.Unknown).ToList();
            }
            else if (SelectedFilter == "MNDCHI")
            {
                parents = parents.Where(p => p.Definition.IsBaseline).ToList();
            }

            if (!string.IsNullOrWhiteSpace(SearchTerm))
            {
                parents = parents.Where(p =>
                    p.Definition.Title.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase) ||
                    p.Definition.Description.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase)
                ).ToList();
            }

            return parents
                .OrderBy(p =>
                {
                    if (p.Definition.IsBaseline)
                    {
                        if (int.TryParse(p.Definition.ControlId, out var num))
                            return (0, num);
                        return (0, 999);
                    }
                    else if (p.Definition.ControlId.StartsWith("EXT-"))
                    {
                        return (1, 0);
                    }
                    else if (p.Definition.ControlId.StartsWith("ERDC-"))
                    {
                        return (2, 0);
                    }
                    return (3, 0);
                })
                .ThenBy(p => p.Definition.ControlId)
                .ToList();
        }
    }

    private int CountAll => GetParentControls().Count;
    private int CountBaseline => GetParentControls().Count(p => p.Definition.IsBaseline);
    private int CountExtended => GetParentControls().Count(p => !p.Definition.IsBaseline);
    private int CountFail => GetParentControls().Count(p => p.CalculatedStatus == CheckStatus.Fail);
    private int CountPass => GetParentControls().Count(p => p.CalculatedStatus == CheckStatus.Pass);
    private int CountUnknown => GetParentControls().Count(p => p.CalculatedStatus == CheckStatus.Unknown);
    private int CountMndchi => CountBaseline;

    private bool IsSelected(ParentControlView parent) =>
        parent.Findings.Any(f => SelectedFindingIds.Contains(f.CheckId));

    private void ToggleSelect(ParentControlView parent)
    {
        foreach (var finding in parent.Findings)
        {
            if (!SelectedFindingIds.Add(finding.CheckId))
                SelectedFindingIds.Remove(finding.CheckId);
        }
    }

    private void ClearSelection() => SelectedFindingIds.Clear();

    private IEnumerable<Finding> GetSelectedFindings()
    {
        if (StateService.CurrentScanResult == null) return Enumerable.Empty<Finding>();
        return StateService.CurrentScanResult.Findings.Where(f => SelectedFindingIds.Contains(f.CheckId));
    }

    private async Task BulkRescan()
    {
        foreach (var f in GetSelectedFindings().ToList())
            await StateService.RescanCheckAsync(f.CheckId);
        ClearSelection();
    }

    private void BulkIgnore()
    {
        foreach (var f in GetSelectedFindings())
        {
            if (!f.IsSuppressed) f.Ignore("Bulk ignore via Findings UI", "Operator");
            StateService.LogAction($"User ignored: {f.CheckId}");
        }
        ClearSelection();
    }

    private void BulkMarkFp()
    {
        foreach (var f in GetSelectedFindings())
        {
            f.MarkFalsePositive();
            StateService.LogAction($"User marked FP: {f.CheckId}");
        }
        ClearSelection();
    }

    private async Task BulkExport()
    {
        var items = GetSelectedFindings().ToList();
        if (!items.Any()) return;
        await DownloadFindingsAsCsv(items, $"DefenDoor_Selected_{DateTime.Now:yyyyMMdd_HHmmss}.csv");
    }

    private void SetFilterAll() => SelectedFilter = "All";
    private void SetFilterBaseline() => SelectedFilter = "Baseline";
    private void SetFilterExtended() => SelectedFilter = "Extended";
    private void SetFilterPass() => SelectedFilter = "Pass";
    private void SetFilterFail() => SelectedFilter = "Fail";
    private void SetFilterUnknown() => SelectedFilter = "Unknown";
    private void SetFilterMndchi() => SelectedFilter = "MNDCHI";
    private void SetCategory(string? c) => SelectedCategory = c;
    private void ClearCategory() => SelectedCategory = null;

    private SubCheck? SelectedSub;
    private HashSet<string> ExpandedIds = new();

    private void OpenDrawer(Finding f) { SelectedFinding = f; SelectedSub = null; }
    private void OpenSubDrawer(Finding f, SubCheck sc) { SelectedFinding = f; SelectedSub = sc; }
    private void ToggleExpanded(string id)
    {
        if (!ExpandedIds.Add(id)) ExpandedIds.Remove(id);
    }
    private void OnDrawerClose() { SelectedFinding = null; SelectedSub = null; }

    private async Task RescanSubControl(string controlId, string subControlId)
    {
        await StateService.RescanSubControlAsync(controlId, subControlId);
    }

    private async Task DownloadFindingsAsCsv(List<Finding> items, string filename)
    {
        var sb = new StringBuilder();
        sb.AppendLine("CheckId,Name,Category,Severity,Status,Current,Expected,CIS,Risk,Source");
        foreach (var f in items)
        {
            sb.AppendLine($"\"{f.CheckId}\",\"{f.Name}\",\"{f.Category}\",\"{f.Severity}\",\"{f.Status}\",\"{f.CurrentValue}\",\"{f.ExpectedValue}\",\"{f.CisReference}\",{f.RiskScore},\"{f.SourceType}\"");
        }
        var bytes = Encoding.UTF8.GetBytes(sb.ToString());
        var b64 = Convert.ToBase64String(bytes);
        var script = $@"(function() {{
            const a = document.createElement('a');
            a.href = 'data:text/csv;base64,{b64}';
            a.download = '{filename}';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        }})();";
        await JS.InvokeVoidAsync("eval", script);
    }

    protected override void OnInitialized()
    {
        StateService.OnChange += HandleStateChanged;
    }

    private void HandleStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        StateService.OnChange -= HandleStateChanged;
    }
}