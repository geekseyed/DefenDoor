@page "/activity"
@rendermode InteractiveServer
@using ISCM.Web.Services
@inject ScanHistoryService HistoryService
@inject ScanStateService StateService
@inject ISCM.Application.Interfaces.ITrendAnalysisService TrendService

<PageTitle>DefenDoor - Activity Log</PageTitle>

<style>
    .glass-panel {
        background: rgba(30, 41, 59, 0.7);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
        height: 100%;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        box-sizing: border-box;
    }

    .header-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
        flex-shrink: 0;
    }

    .btn-back {
        background: #334155;
        border: none;
        padding: 8px 20px;
        color: #06b6d4;
        font-weight: bold;
        border-radius: 6px;
        cursor: pointer;
        text-decoration: none;
    }

    .btn-clear {
        background: #ef4444;
        border: none;
        padding: 8px 20px;
        color: white;
        font-weight: bold;
        border-radius: 6px;
        cursor: pointer;
    }

        .btn-clear:disabled {
            background: #475569;
            cursor: not-allowed;
        }

    .split-container {
        display: flex;
        gap: 20px;
        flex-grow: 1;
        min-height: 0;
    }

    .left-panel {
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .right-panel {
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .panel-title {
        color: #06b6d4;
        font-size: 14px;
        margin-bottom: 10px;
        text-transform: uppercase;
        border-bottom: 1px solid #334155;
        padding-bottom: 5px;
    }

    .log-box {
        background: #000000;
        border: 1px solid #334155;
        border-radius: 8px;
        padding: 10px;
        flex-grow: 1;
        overflow-y: auto;
        font-family: 'Consolas', monospace;
        font-size: 12px;
    }

    .log-line {
        color: #10b981;
        margin-bottom: 5px;
    }

    .table-container {
        flex-grow: 1;
        overflow-y: auto;
        border: 1px solid #1e293b;
        border-radius: 8px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th {
        text-align: left;
        padding: 10px;
        background: #0f172a;
        color: #06b6d4;
        border-bottom: 2px solid #334155;
        position: sticky;
        top: 0;
        font-size: 12px;
    }

    td {
        padding: 10px;
        border-bottom: 1px solid #334155;
        font-size: 12px;
    }

    .grade-badge {
        padding: 4px 12px;
        border-radius: 12px;
        font-weight: bold;
        background: rgba(6, 182, 212, 0.2);
        color: #06b6d4;
        font-size: 11px;
    }
</style>

<div class="glass-panel">
    <div class="header-row">
        <h2 style="color:#e2e8f0;">Activity & Event Log</h2>
        <div style="display: flex; gap: 10px;">
            <button class="btn-clear" @onclick="ClearHistory" disabled="@(!HistoryService.History.Any())">🗑️ Clear History</button>
            <a href="/" class="btn-back">⬅️ Back to Dashboard</a>
        </div>
    </div>
    @if (_isLoadingTrend)
{
    <div style="color:#64748b; text-align:center; padding:20px;">Loading trend data...</div>
}
else
{
    <TrendChart Result="_trendResult" />
}

    <div class="split-container">
        <div class="left-panel">
            <div class="panel-title">User Event Log (Real-time)</div>
            <div class="log-box">
                @if (!StateService.EventLog.Any())
                {
                    <div style="color: #64748b; text-align: center; margin-top: 20px;">No events recorded yet.</div>
                }
                else
                {
                    @foreach (var log in StateService.EventLog)
                    {
                        <div class="log-line">@log</div>
                    }
                }
            </div>
        </div>

        <div class="right-panel">
            <div class="panel-title">Scan History</div>
            <div class="table-container">
                @if (!HistoryService.History.Any())
                {
                    <div style="color: #64748b; text-align: center; margin-top: 20px;">No scans performed yet.</div>
                }
                else
                {
                    <table>
                        <thead>
                            <tr>
                                <th>Time</th>
                                <th>Host</th>
                                <th>Score</th>
                                <th>Grade</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in HistoryService.History)
                            {
                                <tr>
                                    <td style="color: #94a3b8;">@entry.ScanTime.ToString("t")</td>
                                    <td style="color: #e2e8f0;">@entry.Hostname</td>
                                    <td style="color: @(entry.ComplianceScore > 70 ? "#10b981" : "#ef4444"); font-weight: bold;">@entry.ComplianceScore%</td>
                                    <td><span class="grade-badge">@entry.Grade</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private ISCM.Application.Analytics.TrendAnalysisResult? _trendResult;
    private bool _isLoadingTrend = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _trendResult = await TrendService.AnalyzeGlobalTrendAsync(maxDataPoints: 20);
        }
        catch (Exception ex)
        {
            StateService.LogAction($"Failed to load trend data: {ex.Message}");
        }
        finally
        {
            _isLoadingTrend = false;
        }
    }

    private void ClearHistory()
    {
        HistoryService.ClearHistory();
        StateService.LogAction("User cleared scan history.");
    }
}