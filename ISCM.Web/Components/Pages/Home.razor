@page "/"
@rendermode InteractiveServer
@using ISCM.Application.Interfaces
@using ISCM.Domain.Entities
@using ISCM.Domain.Enums
@using ISCM.Web.Services
@inject ScanStateService StateService
@implements IDisposable

<PageTitle>DefenDoor - Dashboard</PageTitle>

<style>
    .glass-panel {
        background: rgba(30, 41, 59, 0.7);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        padding: 12px;
        box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
        margin-bottom: 10px;
        box-sizing: border-box;
    }

    .btn-scan {
        background: linear-gradient(45deg, #06b6d4, #3b82f6);
        border: none;
        padding: 10px 25px;
        color: white;
        font-size: 15px;
        font-weight: bold;
        border-radius: 8px;
        cursor: pointer;
        transition: 0.3s;
        box-shadow: 0 0 15px rgba(6, 182, 212, 0.4);
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-scan:hover {
            transform: translateY(-2px);
            box-shadow: 0 0 25px rgba(6, 182, 212, 0.6);
        }

        .btn-scan:disabled {
            background: #475569;
            cursor: not-allowed;
            box-shadow: none;
            transform: none;
        }

    .dots-wave {
        display: inline-flex;
        gap: 5px;
        align-items: center;
    }

        .dots-wave span {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #ffffff;
            animation: dotWave 1.2s infinite ease-in-out;
        }

            .dots-wave span:nth-child(1) {
                animation-delay: 0s;
            }

            .dots-wave span:nth-child(2) {
                animation-delay: 0.1s;
            }

            .dots-wave span:nth-child(3) {
                animation-delay: 0.2s;
            }

            .dots-wave span:nth-child(4) {
                animation-delay: 0.3s;
            }

            .dots-wave span:nth-child(5) {
                animation-delay: 0.4s;
            }

    @@keyframes dotWave {
        0%, 60%, 100% {
            transform: translateY(0);
            opacity: 0.5;
        }

        30% {
            transform: translateY(-6px);
            opacity: 1;
        }
    }

    .neon-terminal {
        position: relative;
        background: #04060c;
        border: 1px solid rgba(6, 182, 212, 0.35);
        border-radius: 10px;
        box-shadow: 0 0 25px rgba(6, 182, 212, 0.12), inset 0 0 80px rgba(6, 182, 212, 0.04);
        overflow: hidden;
        margin-bottom: 10px;
    }

        .neon-terminal::after {
            content: "";
            position: absolute;
            inset: 0;
            background: repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.025) 0px, rgba(255, 255, 255, 0.025) 1px, transparent 1px, transparent 3px);
            pointer-events: none;
        }

    .terminal-header {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 8px 14px;
        background: rgba(6, 182, 212, 0.07);
        border-bottom: 1px solid rgba(6, 182, 212, 0.25);
    }

        .terminal-header .btn-scan {
            padding: 6px 16px;
            font-size: 12px;
        }

    .terminal-dots {
        display: flex;
        gap: 8px;
        align-items: center;
    }

        .terminal-dots span {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            transition: all 0.15s ease;
        }

    .t-dot-red {
        background: #4a1515;
        box-shadow: 0 0 3px #4a1515;
    }

    .t-dot-green {
        background: #0d3d2c;
        box-shadow: 0 0 3px #0d3d2c;
    }

    .t-dot-red.pulse {
        background: #ef4444;
        box-shadow: 0 0 14px #ef4444, 0 0 24px rgba(239, 68, 68, 0.6);
        animation: dotPulse 0.45s ease-out;
    }

    .t-dot-green.pulse {
        background: #10b981;
        box-shadow: 0 0 14px #10b981, 0 0 24px rgba(16, 185, 129, 0.6);
        animation: dotPulse 0.45s ease-out;
    }

    @@keyframes dotPulse {
        0% {
            transform: scale(1);
        }

        40% {
            transform: scale(1.7);
        }

        100% {
            transform: scale(1);
        }
    }

    .terminal-title {
        font-family: 'Consolas', monospace;
        font-size: 12px;
        letter-spacing: 1px;
        color: #06b6d4;
        text-shadow: 0 0 10px rgba(6, 182, 212, 0.8);
        flex-grow: 1;
    }

    .terminal-chip {
        font-family: 'Consolas', monospace;
        font-size: 11px;
        padding: 3px 10px;
        border-radius: 4px;
        border: 1px solid #334155;
        color: #94a3b8;
        white-space: nowrap;
    }

        .terminal-chip.scanning {
            color: #ffb020;
            border-color: rgba(255, 176, 32, 0.5);
            text-shadow: 0 0 8px rgba(255, 176, 32, 0.7);
        }

        .terminal-chip.complete {
            color: #00ff9c;
            border-color: rgba(0, 255, 156, 0.5);
            text-shadow: 0 0 8px rgba(0, 255, 156, 0.7);
        }

        .terminal-chip.failed {
            color: #ff3860;
            border-color: rgba(255, 56, 96, 0.5);
            text-shadow: 0 0 8px rgba(255, 56, 96, 0.7);
        }

    .terminal-body {
        height: 220px;
        overflow-y: auto;
        display: flex;
        flex-direction: column-reverse;
        padding: 12px 16px;
        font-family: 'Consolas', monospace;
        font-size: 12.5px;
        line-height: 1.7;
        scrollbar-width: thin;
        scrollbar-color: #164e63 #04060c;
    }

    .log-placeholder {
        color: #475569;
    }

    .log-info {
        color: #7dd3fc;
        text-shadow: 0 0 6px rgba(125, 211, 252, 0.45);
    }

    .log-pass {
        color: #00ff9c;
        text-shadow: 0 0 8px rgba(0, 255, 156, 0.55);
    }

    .log-fail {
        color: #ff3860;
        text-shadow: 0 0 8px rgba(255, 56, 96, 0.55);
    }

    .log-warn {
        color: #ffb020;
        text-shadow: 0 0 8px rgba(255, 176, 32, 0.55);
    }

    .terminal-prompt {
        color: #06b6d4;
        text-shadow: 0 0 8px rgba(6, 182, 212, 0.7);
    }

    .terminal-cursor {
        display: inline-block;
        width: 8px;
        height: 14px;
        background: #00ff9c;
        vertical-align: middle;
        margin-left: 6px;
        box-shadow: 0 0 8px rgba(0, 255, 156, 0.8);
        animation: blink 1s steps(1) infinite;
    }

    @@keyframes blink {
        50% {
            opacity: 0;
        }
    }

    .terminal-footer {
        display: flex;
        border-top: 1px solid rgba(6, 182, 212, 0.25);
        background: rgba(6, 182, 212, 0.05);
    }

    .summary-item {
        flex: 1;
        padding: 8px 12px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2px;
        border-right: 1px solid rgba(6, 182, 212, 0.12);
    }

        .summary-item:last-child {
            border-right: none;
        }

    .summary-num {
        font-size: 14px;
        font-weight: 700;
        font-family: 'Consolas', monospace;
        color: #e2e8f0;
    }

        .summary-num.pass {
            color: #00ff9c;
            text-shadow: 0 0 8px rgba(0, 255, 156, 0.5);
        }

        .summary-num.fail {
            color: #ff3860;
            text-shadow: 0 0 8px rgba(255, 56, 96, 0.5);
        }

        .summary-num.warn {
            color: #ffb020;
            text-shadow: 0 0 8px rgba(255, 176, 32, 0.5);
        }

    .summary-label {
        font-size: 9px;
        color: #64748b;
        text-transform: uppercase;
    }

    .two-col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

    .panel-title {
        color: #94a3b8;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-weight: bold;
    }

    .panel-title-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
    }

    .btn-edit {
        background: #334155;
        border: none;
        color: #e2e8f0;
        font-size: 11px;
        font-weight: bold;
        padding: 4px 14px;
        border-radius: 4px;
        cursor: pointer;
    }

        .btn-edit:hover {
            background: #475569;
        }

        .btn-edit:disabled {
            background: #1e293b;
            color: #475569;
            cursor: not-allowed;
            opacity: 0.5;
        }

    .score-layout {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .score-ring {
        position: relative;
        width: 110px;
        height: 110px;
        flex-shrink: 0;
    }

        .score-ring svg {
            width: 100%;
            height: 100%;
            transform: rotate(-90deg);
        }

        .score-ring circle {
            fill: none;
            stroke-width: 8;
        }

    .ring-bg {
        stroke: rgba(255, 255, 255, 0.1);
    }

    .ring-fill {
        stroke-linecap: round;
        transition: stroke-dashoffset 0.5s ease;
    }

    .score-value {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        text-align: center;
    }

    .score-percent {
        font-size: 22px;
        font-weight: 800;
        line-height: 1;
        color: #e2e8f0;
    }

    .score-grade-text {
        font-size: 11px;
        color: #94a3b8;
        margin-top: 2px;
    }

    .score-stats {
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .stat-row {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        color: #94a3b8;
        border-bottom: 1px solid rgba(255,255,255,0.05);
        padding-bottom: 6px;
    }

    .stat-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
    }

        .stat-dot.pass {
            background: #10b981;
        }

        .stat-dot.fail {
            background: #ef4444;
        }

        .stat-dot.warn {
            background: #f59e0b;
        }

    .stat-num {
        font-size: 15px;
        font-weight: 700;
        font-family: 'Consolas', monospace;
        margin-left: auto;
        color: #e2e8f0;
    }

        .stat-num.pass {
            color: #10b981;
        }

        .stat-num.fail {
            color: #ef4444;
        }

        .stat-num.warn {
            color: #f59e0b;
        }

    .donut-section {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-top: 12px;
        padding-top: 12px;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
    }

    .donut-chart {
        position: relative;
        width: 70px;
        height: 70px;
        flex-shrink: 0;
    }

        .donut-chart svg {
            width: 100%;
            height: 100%;
            transform: rotate(-90deg);
        }

    .donut-center {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        text-align: center;
    }

    .donut-num {
        font-size: 14px;
        font-weight: 700;
        color: #e2e8f0;
    }

    .donut-label {
        font-size: 8px;
        color: #64748b;
        text-transform: uppercase;
    }

    .donut-legend {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .legend-item {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 11px;
        color: #94a3b8;
    }

    .legend-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        flex-shrink: 0;
    }

        .legend-dot.pass {
            background: #10b981;
        }

        .legend-dot.fail {
            background: #ef4444;
        }

        .legend-dot.warn {
            background: #f59e0b;
        }

    .legend-num {
        font-weight: bold;
        font-family: 'Consolas', monospace;
        margin-left: auto;
        color: #e2e8f0;
    }

    .sys-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 9px 0;
        border-bottom: 1px solid rgba(51, 65, 85, 0.5);
        font-size: 13px;
    }

    .sys-label {
        color: #64748b;
        text-transform: uppercase;
        font-size: 11px;
    }

    .sys-value {
        color: #e2e8f0;
        font-family: 'Consolas', monospace;
        font-weight: bold;
    }

    .sys-input {
        background: #0f172a;
        border: 1px solid #334155;
        color: #e2e8f0;
        font-family: 'Consolas', monospace;
        font-size: 12px;
        padding: 4px 8px;
        border-radius: 4px;
        width: 55%;
    }

    .edit-actions {
        display: flex;
        gap: 8px;
        margin-top: 12px;
    }

    .btn-save {
        background: #10b981;
        border: none;
        color: white;
        font-weight: bold;
        font-size: 12px;
        padding: 6px 18px;
        border-radius: 6px;
        cursor: pointer;
    }

    .btn-cancel {
        background: #475569;
        border: none;
        color: white;
        font-weight: bold;
        font-size: 12px;
        padding: 6px 18px;
        border-radius: 6px;
        cursor: pointer;
    }

    .category-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 10px;
    }

    .category-card {
        background: rgba(15, 23, 42, 0.8);
        border: 1px solid #334155;
        border-radius: 8px;
        padding: 12px;
        text-decoration: none;
        display: block;
        transition: 0.3s;
    }

        .category-card:hover {
            border-color: #06b6d4;
            transform: translateY(-2px);
        }

    .category-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
    }

    .category-title {
        color: #94a3b8;
        font-size: 11px;
        font-weight: bold;
        text-transform: uppercase;
    }

    .category-pct {
        font-weight: 800;
        font-family: 'Consolas', monospace;
        font-size: 14px;
    }

    .progress-track {
        height: 4px;
        background: #1e293b;
        border-radius: 2px;
        overflow: hidden;
        margin-bottom: 8px;
    }

    .progress-fill {
        height: 100%;
        border-radius: 2px;
        transition: width 0.5s ease;
    }

    .category-sub {
        color: #64748b;
        font-size: 10px;
    }
</style>

<div class="neon-terminal">
    <div class="terminal-header">
        <div class="terminal-dots">
            <span class="t-dot-red @(StateService.LastCheckResult?.Status == CheckStatus.Fail ? "pulse" : "")" @key="@($"r{_redKey}")"></span>
            <span class="t-dot-green @(StateService.LastCheckResult?.Status == CheckStatus.Pass ? "pulse" : "")" @key="@($"g{_greenKey}")"></span>
        </div>
        <div class="terminal-title">DEFENDOOR.SCAN — @StateService.DisplayHostname</div>
        
        <!-- Phase 15.1: Display current running check ID during scan -->
        @if (StateService.IsScanning && !string.IsNullOrEmpty(StateService.CurrentCheckName))
        {
            <div class="terminal-chip scanning">▶ @StateService.CurrentCheckId</div>
        }
        else
        {
            <div class="terminal-chip @StateService.ConsoleStatusClass">@StateService.ConsoleStatusText</div>
        }

        <button class="btn-scan" @onclick="() => StateService.ExecuteScanAsync()" disabled="@StateService.IsScanning">
            @if (StateService.IsScanning)
            {
                <span class="dots-wave"><span></span><span></span><span></span><span></span><span></span></span>
                <span>Scanning...</span>
            }
            else if (StateService.CurrentScanResult != null)
            {
                <span>🔄 Restart Scan</span>
            }
            else
            {
                <span>🔍 Start Scan</span>
            }
        </button>
    </div>

    <div class="terminal-body">
        <div class="log-info">
            <span class="terminal-prompt">DefenDoor Scan &gt;</span><span class="terminal-cursor"></span>
        </div>
        @if (!StateService.ConsoleLogs.Any() && !StateService.IsScanning)
        {
            <div class="log-placeholder">[--:--:--] Click "Start Scan" to begin.</div>
        }
        else
        {
            foreach (var log in StateService.ConsoleLogs.AsEnumerable().Reverse())
            {
                @if (log.TrimStart().StartsWith("├─") || log.TrimStart().StartsWith("└─"))
                {
                    <div class="@GetLogClass(log)" style="margin-left: 24px; font-size: 11px;">@log</div>
                }
                else
                {
                    <div class="@GetLogClass(log)">@log</div>
                }
            }
        }
    </div>

    <div class="terminal-footer">
        <div class="summary-item"><div class="summary-num pass">@PassedDisplay</div><div class="summary-label">Passed</div></div>
        <div class="summary-item"><div class="summary-num fail">@FailedDisplay</div><div class="summary-label">Failed</div></div>
        <div class="summary-item"><div class="summary-num warn">@WarningDisplay</div><div class="summary-label">Warning</div></div>
        <div class="summary-item"><div class="summary-num">@StateService.ScanDuration</div><div class="summary-label">Duration</div></div>
        <div class="summary-item"><div class="summary-num">@ChecksDisplay</div><div class="summary-label">Checks</div></div>
    </div>
</div>

<div class="two-col">
    <div class="glass-panel" style="margin-bottom: 0;">
        <div class="panel-title" style="margin-bottom: 12px;">Compliance Score</div>
        <div class="score-layout">
            <div class="score-ring">
                <svg viewBox="0 0 120 120">
                    <circle class="ring-bg" cx="60" cy="60" r="52" />
                    @if (StateService.CurrentScanResult != null)
                    {
                        <circle class="ring-fill" cx="60" cy="60" r="52"
                                stroke-dasharray="@RingCircumference"
                                stroke-dashoffset="@RingOffset"
                                stroke="@ScoreColor" />
                    }
                </svg>
                <div class="score-value">
                    @if (StateService.CurrentScanResult != null)
                    {
                        <div class="score-percent" style="color: @ScoreColor;">@StateService.CurrentScanResult.ComplianceScore%</div>
                        <div class="score-grade-text">Grade @StateService.CurrentScanResult.Grade</div>
                    }
                    else
                    {
                        <div class="score-percent">—</div>
                        <div class="score-grade-text">—</div>
                    }
                </div>
            </div>
            <div class="score-stats">
                <div class="stat-row"><span class="stat-dot pass"></span> Passed <span class="stat-num pass">@ResultOr0(StateService.CurrentScanResult?.PassCount)</span></div>
                <div class="stat-row"><span class="stat-dot fail"></span> Failed <span class="stat-num fail">@ResultOr0(StateService.CurrentScanResult?.FailCount)</span></div>
                <div class="stat-row"><span class="stat-dot warn"></span> Warning <span class="stat-num warn">@ResultOr0(StateService.CurrentScanResult?.WarningCount)</span></div>
            </div>
        </div>

        <div class="donut-section">
            <div class="donut-chart">
                <svg viewBox="0 0 36 36">
                    <circle cx="18" cy="18" r="15.915" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="3" />
                    <circle cx="18" cy="18" r="15.915" fill="none" stroke="#10b981" stroke-width="3" stroke-dasharray="@(PassPct) @(100-PassPct)" stroke-dashoffset="0" />
                    <circle cx="18" cy="18" r="15.915" fill="none" stroke="#ef4444" stroke-width="3" stroke-dasharray="@(FailPct) @(100-FailPct)" stroke-dashoffset="@(-PassPct)" />
                    <circle cx="18" cy="18" r="15.915" fill="none" stroke="#f59e0b" stroke-width="3" stroke-dasharray="@(WarnPct) @(100-WarnPct)" stroke-dashoffset="@(-(PassPct + FailPct))" />
                </svg>
                <div class="donut-center"><div class="donut-num">@TotalChecksCount</div><div class="donut-label">Checks</div></div>
            </div>
            <div class="donut-legend">
                <div class="legend-item"><span class="legend-dot pass"></span> PASS <span class="legend-num">@ResultOr0(StateService.CurrentScanResult?.PassCount)</span></div>
                <div class="legend-item"><span class="legend-dot fail"></span> FAIL <span class="legend-num">@ResultOr0(StateService.CurrentScanResult?.FailCount)</span></div>
                <div class="legend-item"><span class="legend-dot warn"></span> WARN <span class="legend-num">@ResultOr0(StateService.CurrentScanResult?.WarningCount)</span></div>
            </div>
        </div>
    </div>

    <div class="glass-panel" style="margin-bottom: 0;">
        <div class="panel-title-row">
            <div class="panel-title">System Information</div>
            @if (!StateService.IsEditingSystemInfo)
            {
                <button class="btn-edit" @onclick="StateService.StartEditingSystemInfo" disabled="@(StateService.CurrentScanResult == null)">Edit</button>
            }
        </div>

        @if (StateService.IsEditingSystemInfo)
        {
            <div class="sys-row"><span class="sys-label">Hostname</span><input class="sys-input" @bind="StateService.DraftHostname" placeholder="Hostname" /></div>
            <div class="sys-row"><span class="sys-label">IP Address</span><input class="sys-input" @bind="StateService.DraftIpAddress" placeholder="IP Address" /></div>
            <div class="sys-row"><span class="sys-label">OS Version</span><input class="sys-input" @bind="StateService.DraftOsVersion" placeholder="OS Version" /></div>
            <div class="sys-row"><span class="sys-label">Build</span><input class="sys-input" @bind="StateService.DraftOsBuild" placeholder="Build" /></div>
            <div class="edit-actions">
                <button class="btn-save" @onclick="StateService.SaveSystemInfoEdits">Save</button>
                <button class="btn-cancel" @onclick="StateService.CancelSystemInfoEdits">Cancel</button>
            </div>
        }
        else
        {
            <div class="sys-row"><span class="sys-label">Hostname</span><span class="sys-value">@StateService.DisplayHostname</span></div>
            <div class="sys-row"><span class="sys-label">IP Address</span><span class="sys-value">@StateService.DisplayIpAddress</span></div>
            <div class="sys-row"><span class="sys-label">OS Version</span><span class="sys-value">@StateService.DisplayOsVersion</span></div>
            <div class="sys-row"><span class="sys-label">Build</span><span class="sys-value">@StateService.DisplayOsBuild</span></div>

            <!-- ✅ Phase 3.4: نمایش نام Baseline فعال (در حالت عادی) -->
            <div class="sys-row">
                <span class="sys-label">Active Baseline</span>
                <span class="sys-value" style="color: #06b6d4; font-size: 11px;">@StateService.BaselineName</span>
            </div>

            <div class="sys-row"><span class="sys-label">Scan Time</span><span class="sys-value">@StateService.ScanTimeText</span></div>
        }
    </div>
</div>

<div class="category-grid" style="margin-top: 10px;">
    @foreach (var group in CategoryBreakdown)
    {
        var pct = GetCategoryPercent(group);
        var barColor = GetBarColor(pct);
        <a href="@($"/findings?category={group.Category}")" class="category-card">
            <div class="category-head">
                <div class="category-title">@GetCategoryLabel(group.Category)</div>
                <div class="category-pct" style="color: @barColor;">@(group.HasResult ? $"{pct}%" : "—")</div>
            </div>
            <div class="progress-track">
                <div class="progress-fill" style="width: @(group.HasResult ? pct : 0)%; background: @barColor;"></div>
            </div>
            <div class="category-sub">
                @(group.HasResult ? $"{group.PassCount} pass {group.FailCount} issues" : "0 pass 0 fail")
            </div>
        </a>
    }
</div>

@code {
    public class CategoryStat
    {
        public string Category { get; set; } = "";
        public int PassCount { get; set; }
        public int FailCount { get; set; }
        public bool HasResult { get; set; }
    }

    private List<CategoryStat> CategoryBreakdown { get; set; } = new();
    private int _redKey = 0;
    private int _greenKey = 0;
    private int _lastPass = 0;
    private int _lastFail = 0;

    protected override void OnInitialized()
    {
        StateService.OnChange += HandleStateChanged;
        CalculateCategoryBreakdown();
    }

    private void HandleStateChanged()
    {
        InvokeAsync(() =>
        {
            CalculateCategoryBreakdown();

            if (StateService.LivePassCount != _lastPass)
            {
                _lastPass = StateService.LivePassCount;
                _greenKey++;
            }
            if (StateService.LiveFailCount != _lastFail)
            {
                _lastFail = StateService.LiveFailCount;
                _redKey++;
            }

            StateHasChanged();
        });
    }

    private void CalculateCategoryBreakdown()
    {
        var allFindings = StateService.CurrentScanResult?.Findings ?? new List<Finding>();

        CategoryBreakdown = Enum.GetValues(typeof(CheckCategory)).Cast<CheckCategory>().Select(c =>
        {
            var findings = allFindings.Where(f => f.Category == c).ToList();

            return new CategoryStat
                {
                    Category = c.ToString(),
                    PassCount = findings.Count(f => f.Status == CheckStatus.Pass),
                    FailCount = findings.Count(f => f.Status == CheckStatus.Fail),
                    HasResult = StateService.CurrentScanResult != null
                };
        }).ToList();
    }

    private static int GetCategoryPercent(CategoryStat s)
        => (s.PassCount + s.FailCount) == 0 ? 0 : (int)Math.Round((double)s.PassCount / (s.PassCount + s.FailCount) * 100);

    private static string GetBarColor(int pct)
        => pct >= 100 ? "#10b981" : pct >= 50 ? "#f59e0b" : "#ef4444";

    // ✅ متد تبدیل نام دسته‌بندی‌ها به برچسب‌های حرفه‌ای
    private string GetCategoryLabel(string category)
    {
        return category switch
        {
            "Account" => "Account & Access Policies",
            "Network" => "Network & Communication Security",
            "System" => "System Hardening & Protections",
            "Audit" => "Auditing, Logging & Monitoring",
            _ => category
        };
    }

    private string PassedDisplay
    {
        get
        {
            if (StateService.IsScanning)
                return StateService.LivePassCount.ToString();
            return StateService.CurrentScanResult?.PassCount.ToString() ?? "—";
        }
    }

    private string FailedDisplay
    {
        get
        {
            if (StateService.IsScanning)
                return StateService.LiveFailCount.ToString();
            return StateService.CurrentScanResult?.FailCount.ToString() ?? "—";
        }
    }

    private string WarningDisplay => StateService.CurrentScanResult?.WarningCount.ToString() ?? "—";

    private string ChecksDisplay
    {
        get
        {
            if (StateService.IsScanning) return $"{StateService.CompletedChecks}/{StateService.ExpectedChecks}";
            return StateService.CurrentScanResult != null ? $"{StateService.TotalChecks}/{StateService.TotalChecks}" : "—";
        }
    }

    private static string GetLogClass(string log)
    {
        if (log.Contains("[PASS]")) return "log-pass";
        if (log.Contains("[FAIL]")) return "log-fail";
        if (log.Contains("[WARN]")) return "log-warn";
        return "log-info";
    }

    private const double RingCircumference = 326.7;
    private double RingOffset => StateService.CurrentScanResult == null ? RingCircumference
        : RingCircumference - (RingCircumference * StateService.CurrentScanResult.ComplianceScore / 100.0);
    private string ScoreColor => StateService.CurrentScanResult != null && StateService.CurrentScanResult.ComplianceScore > 70 ? "#10b981" : "#ef4444";

    private int TotalChecksCount => StateService.CurrentScanResult?.Findings.Count ?? 0;
    private double PassPct => TotalChecksCount > 0 ? (double)(StateService.CurrentScanResult?.PassCount ?? 0) / TotalChecksCount * 100 : 0;
    private double FailPct => TotalChecksCount > 0 ? (double)(StateService.CurrentScanResult?.FailCount ?? 0) / TotalChecksCount * 100 : 0;
    private double WarnPct => TotalChecksCount > 0 ? (double)(StateService.CurrentScanResult?.WarningCount ?? 0) / TotalChecksCount * 100 : 0;

    private static int ResultOr0(int? value) => value ?? 0;

    public void Dispose()
    {
        StateService.OnChange -= HandleStateChanged;
    }
}