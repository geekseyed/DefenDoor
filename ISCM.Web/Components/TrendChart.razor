@using ISCM.Application.Analytics

<div class="trend-chart-container">
    <div class="trend-chart-header">
        <span class="trend-chart-title">📈 Compliance Trend</span>
        <div class="trend-chart-legend">
            <span class="legend-item"><span class="legend-dot" style="background:#06b6d4;"></span> Score</span>
            <span class="legend-item"><span class="legend-dot" style="background:#10b981;"></span> Pass</span>
            <span class="legend-item"><span class="legend-dot" style="background:#ef4444;"></span> Fail</span>
        </div>
    </div>

    @if (Result == null || Result.DataPoints.Count < 2)
    {
        <div class="trend-chart-empty">
            @if (Result == null || Result.DataPoints.Count == 0)
            {
                <span>No data available. Run at least 2 scans to see trends.</span>
            }
            else
            {
                <span>Not enough data points for trend visualization.</span>
            }
        </div>
    }
    else
    {
        <svg viewBox="0 0 800 300" class="trend-svg" preserveAspectRatio="xMidYMid meet">
            <!-- Grid Lines -->
            @for (int i = 0; i <= 4; i++)
            {
                var y = 20 + (i * 65);
                var value = 100 - (i * 25);
                <line x1="50" y1="@y" x2="780" y2="@y" stroke="#334155" stroke-width="1" stroke-dasharray="4,4" />
                @((MarkupString)$"<text x=\"10\" y=\"{y + 4}\" fill=\"#64748b\" font-size=\"11\">{value}</text>")
            }

            <!-- X Axis Labels (dates) -->
            @for (int i = 0; i < Result.DataPoints.Count; i++)
            {
                var x = GetX(i);
                var dateLabel = Result.DataPoints[i].Timestamp.ToString("MM/dd");
                @((MarkupString)$"<text x=\"{x}\" y=\"295\" fill=\"#64748b\" font-size=\"10\" text-anchor=\"middle\">{dateLabel}</text>")
            }

            <!-- Trend Lines -->
            <polyline points="@GetLinePoints(p => p.ComplianceScore)" fill="none" stroke="#06b6d4" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
            <polyline points="@GetLinePoints(p => p.PassCount)" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0.8" />
            <polyline points="@GetLinePoints(p => p.FailCount)" fill="none" stroke="#ef4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0.8" />

            <!-- Data Points for Score -->
            @for (int i = 0; i < Result.DataPoints.Count; i++)
            {
                var x = GetX(i);
                var y = GetY(Result.DataPoints[i].ComplianceScore);
                <circle cx="@x" cy="@y" r="5" fill="#06b6d4" stroke="#0f172a" stroke-width="2">
                    <title>@($"{Result.DataPoints[i].Hostname} | {Result.DataPoints[i].ComplianceScore}% | {Result.DataPoints[i].Timestamp:yyyy-MM-dd}")</title>
                </circle>
            }
        </svg>

        <!-- Summary Stats -->
        <div class="trend-summary">
            <div class="trend-stat">
                <span class="trend-stat-label">Direction</span>
                <span class="trend-stat-value @Result.Direction.ToString().ToLower()">
                    @(Result.Direction switch
                    {
                        TrendDirection.Improving => "📈 Improving",
                        TrendDirection.Regressing => "📉 Regressing",
                        TrendDirection.Stable => "➡️ Stable",
                        _ => "❓ N/A"
                    })
                </span>
            </div>
            <div class="trend-stat">
                <span class="trend-stat-label">Average</span>
                <span class="trend-stat-value">@Result.AverageScore%</span>
            </div>
            <div class="trend-stat">
                <span class="trend-stat-label">Delta</span>
                <span class="trend-stat-value @(Result.OverallDelta >= 0 ? "positive" : "negative")">
                    @(Result.OverallDelta >= 0 ? "+" : "")@Result.OverallDelta%
                </span>
            </div>
            <div class="trend-stat">
                <span class="trend-stat-label">Scans</span>
                <span class="trend-stat-value">@Result.TotalScans</span>
            </div>
        </div>
    }
</div>

<style>
    .trend-chart-container {
        background: rgba(15, 23, 42, 0.6);
        border: 1px solid #1e293b;
        border-radius: 10px;
        padding: 16px;
        margin-bottom: 16px;
    }

    .trend-chart-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
    }

    .trend-chart-title {
        color: #e2e8f0;
        font-weight: bold;
        font-size: 14px;
    }

    .trend-chart-legend {
        display: flex;
        gap: 12px;
        font-size: 11px;
        color: #94a3b8;
    }

    .legend-item {
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .legend-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        display: inline-block;
    }

    .trend-svg {
        width: 100%;
        height: auto;
        display: block;
    }

    .trend-chart-empty {
        color: #64748b;
        text-align: center;
        padding: 40px;
        font-size: 13px;
    }

    .trend-summary {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
        margin-top: 12px;
    }

    .trend-stat {
        background: rgba(30, 41, 59, 0.5);
        border-radius: 6px;
        padding: 10px;
        text-align: center;
    }

    .trend-stat-label {
        display: block;
        color: #64748b;
        font-size: 10px;
        text-transform: uppercase;
        margin-bottom: 4px;
    }

    .trend-stat-value {
        color: #e2e8f0;
        font-weight: bold;
        font-size: 14px;
        font-family: 'Consolas', monospace;
    }

        .trend-stat-value.improving {
            color: #10b981;
        }

        .trend-stat-value.regressing {
            color: #ef4444;
        }

        .trend-stat-value.stable {
            color: #06b6d4;
        }

        .trend-stat-value.positive {
            color: #10b981;
        }

        .trend-stat-value.negative {
            color: #ef4444;
        }
</style>

@code {
    [Parameter] public TrendAnalysisResult? Result { get; set; }

    private const int PaddingLeft = 50;
    private const int PaddingRight = 20;
    private const int PaddingTop = 20;
    private const int PaddingBottom = 30;
    private const int ChartWidth = 800;
    private const int ChartHeight = 300;
    private const int PlotWidth = ChartWidth - PaddingLeft - PaddingRight;
    private const int PlotHeight = ChartHeight - PaddingTop - PaddingBottom;

    private double GetX(int index)
    {
        if (Result == null || Result.DataPoints.Count <= 1) return PaddingLeft;
        var step = (double)PlotWidth / (Result.DataPoints.Count - 1);
        return PaddingLeft + (index * step);
    }

    private double GetY(double value)
    {
        var clamped = Math.Clamp(value, 0, 100);
        var ratio = clamped / 100.0;
        return PaddingTop + PlotHeight - (ratio * PlotHeight);
    }

    private string GetLinePoints(Func<TrendDataPoint, double> selector)
    {
        if (Result == null || Result.DataPoints.Count == 0) return string.Empty;
        return string.Join(" ", Result.DataPoints.Select((p, i) => $"{GetX(i)},{GetY(selector(p))}"));
    }
}