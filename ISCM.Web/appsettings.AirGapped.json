{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Error"
    }
  },
  "Scanner": {
    "CacheMaxAgeMinutes": 1440,
    "EnableCache": true,
    "MaxScanDurationMinutes": 180,
    "ParserTimeoutSeconds": 180,
    "CheckTimeoutSeconds": 300,
    "MaxDegreeOfParallelism": 1,
    "EnableFingerprintValidation": false,
    "EnableFreshnessPolicy": true,
    "VerboseLogging": false,
    "LogRawOutput": false
  }
}