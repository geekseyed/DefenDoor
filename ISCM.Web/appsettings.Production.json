{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Error"
    }
  },
  "Scanner": {
    "CacheMaxAgeMinutes": 60,
    "EnableCache": true,
    "MaxScanDurationMinutes": 120,
    "ParserTimeoutSeconds": 60,
    "CheckTimeoutSeconds": 120,
    "MaxDegreeOfParallelism": 0,
    "EnableFingerprintValidation": true,
    "EnableFreshnessPolicy": true,
    "VerboseLogging": false,
    "LogRawOutput": false
  }
}